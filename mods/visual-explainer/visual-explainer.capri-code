        private static System.Collections.Generic.List<ExplainMapCountry> countries;

        internal static System.Collections.Generic.List<ExplainMapCountry> Countries
        {
            get
            {
                if (countries != null) return countries;
                System.Collections.Generic.Dictionary<string, object> data = (System.Collections.Generic.Dictionary<string, object>)CardJson.Read("{\"countries\":" + Json + "}");
                System.Collections.Generic.List<object> root = data["countries"] as System.Collections.Generic.List<object>;
                countries = new System.Collections.Generic.List<ExplainMapCountry>();
                foreach (object entry in root)
                {
                    System.Collections.Generic.List<object> country = entry as System.Collections.Generic.List<object>;
                    if (country == null || country.Count != 3) continue;
                    ExplainMapCountry made = new ExplainMapCountry { Name = country[0] as string, Continent = country[1] as string, Rings = new System.Collections.Generic.List<System.Drawing.PointF[]>() };
                    System.Collections.Generic.List<object> rings = country[2] as System.Collections.Generic.List<object>;
                    if (rings == null) continue;
                    foreach (object raw in rings)
                    {
                        System.Collections.Generic.List<object> coords = raw as System.Collections.Generic.List<object>;
                        if (coords == null || coords.Count < 6 || coords.Count % 2 != 0) continue;
                        System.Collections.Generic.List<System.Drawing.PointF> points = new System.Collections.Generic.List<System.Drawing.PointF>();
                        int x = 0, y = 0;
                        for (int i = 0; i + 1 < coords.Count; i += 2)
                        {
                            if (!(coords[i] is double) || !(coords[i + 1] is double)) continue;
                            if (i == 0) { x = (int)(double)coords[i]; y = (int)(double)coords[i + 1]; }
                            else { x += (int)(double)coords[i]; y += (int)(double)coords[i + 1]; }
                            points.Add(new System.Drawing.PointF(x / 50f, y / 50f));
                        }
                        if (points.Count >= 3) made.Rings.Add(points.ToArray());
                    }
                    if (made.Name != null && made.Rings.Count > 0) countries.Add(made);
                }
                return countries;
            }
        }
    }
    // One link on a sources card.
    internal sealed class ExplainSource
    {
        public string Name;
        public string Url;
    }

    // One stop on a timeline card.
    internal sealed class ExplainEvent
    {
        public string When;
        public string Text;
    }

    // One box in a flow card.
    internal sealed class ExplainNode
    {
        public string Id;
        public string Text;
        public string Shape;
        public string Tone;
    }

    // One arrow between two flow nodes.
    internal sealed class ExplainLink
    {
        public string From;
        public string To;
        public string Label;
        public bool? Flow;
    }

    // One bar on a bars card.
    internal sealed class ExplainBar
    {
        public string Label;
        public double Value;
        public string Tone;
    }

    // One coloured key on a legend card.
    internal sealed class ExplainKey
    {
        public string Tone;
        public string Text;
    }

    // One question on a quiz card.
    internal sealed class ExplainQuestion
    {
        public string Text;
        public string[] Options;
        public string Answer;
        public string Explain;
    }

    internal sealed class ExplainPoint
    {
        public double X;
        public double Y;
        public string Label;
    }

    internal sealed class ExplainPlot
    {
        public double[][] Points;
        public string Tone;
        public string Label;
    }

    internal sealed class ExplainVertex
    {
        public string Id;
        public double X;
        public double Y;
    }

    internal sealed class ExplainFigureLine
    {
        public string From;
        public string To;
        public string Label;
        public bool Dash;
        public string Tone;
    }

    internal sealed class ExplainAngle
    {
        public string At;
        public string From;
        public string To;
        public string Label;
    }

    internal sealed class ExplainCircle
    {
        public string At;
        public double Radius;
        public string Label;
        public string Tone;
    }

    internal sealed class ExplainBranch
    {
        public string Text;
        public string[] Items;
        public string Tone;
    }

    internal sealed class ExplainMapShade
    {
        public string Name;
        public string Tone;
    }

    internal sealed class ExplainMapPin
    {
        public string Name;
        public double Lat;
        public double Lon;
    }

    internal sealed class ExplainMapRoute
    {
        public string From;
        public string To;
        public string Tone;
    }

    // One card: the shape is the same for every kind, and each kind reads the parts it needs.
    internal sealed class ExplainCard
    {
        public string Kind;
        public string Title;
        public string Heading;
        public string Text;
        public string Tone;
        public string Label;
        public string[] Items;
        public ExplainSource[] Sources;
        public ExplainEvent[] Events;
        public ExplainNode[] Nodes;
        public ExplainLink[] Links;
        public string[] Columns;
        public string[][] Rows;
        public ExplainBar[] Bars;
        public string Unit;
        public ExplainKey[] Keys;
        public ExplainQuestion[] Questions;
        public double[] XRange;
        public double[] YRange;
        public ExplainPlot[] Plots;
        public ExplainPoint[] Dots;
        public ExplainVertex[] Vertices;
        public ExplainFigureLine[] FigureLines;
        public ExplainAngle[] Angles;
        public ExplainCircle[] Circles;
        public ExplainBranch[] Branches;
        public string Region;
        public ExplainMapShade[] Shade;
        public ExplainMapPin[] Pins;
        public ExplainMapRoute[] Routes;
    }

    // One beat: a spoken line and the cards that go with it.
    internal sealed class ExplainBeat
    {
        public string Say;
        public ExplainCard[] Cards;
    }

    // Her explainer cards: interactive, native windows that sit on calm space and teach with cards, diagrams,
    // timelines, tables, bars and quizzes. Pinned cards stay through a new beat or a new explanation.
    internal sealed class Explainer : IDisposable
    {
        internal const int MaxCards = 4;
        // Keep the cards inset from the top edge while leaving the upper screen open.
        internal const int Headroom = 96;
        internal const string Question = "What should I explain, choom?";
        internal const string NoCards = "Couldn't read any cards to show.";
        internal const string LastBeat = "That's the last beat.";
        internal const string Cleared = "Cleared my explainer cards.";

        private readonly List<ExplainCardWindow> windows = new List<ExplainCardWindow>();
        private ExplainBeat[] beats = new ExplainBeat[0];
        private int beatIndex = -1;
        // Roamies plays a drawing a beat at a time, and hers does the same: a set arrives one card after another
        // rather than all at once. This is how long each one gets before the next follows, and the tests turn it down.
        internal int AutoMs = 2500;
        private readonly List<ExplainCard> queued = new List<ExplainCard>();
        private int offered;
        private Beat auto;
        private Beat expiry;
        internal Action<Point> Aim;
        internal Action Done;
        internal Action Idle;

        internal bool Has { get { return windows.Count > 0; } }
        internal bool Finished
        {
            get
            {
                if (queued.Count > 0 || beatIndex + 1 < beats.Length) return false;
                foreach (ExplainCardWindow window in windows) if (window.Drawing) return false;
                return windows.Count > 0;
            }
        }

        internal string Show(ExplainBeat[] given, ExplainCard[] cards)
        {
            StopExpiry();
            CloseUnpinned();
            StopAuto();
            queued.Clear();
            offered = 0;
            if (given != null && given.Length > 0)
            {
                List<ExplainBeat> keep = new List<ExplainBeat>();
                foreach (ExplainBeat beat in given) if (beat != null) keep.Add(beat);
                beats = keep.ToArray();
                beatIndex = -1;
                if (beats.Length == 0) return Question;
                return Next();
            }
            beats = new ExplainBeat[0];
            beatIndex = -1;
            // Everything she offered joins the queue; only what can actually be drawn goes on it, so the count
            // she is told back is the count that will arrive.
            if (cards != null)
                foreach (ExplainCard card in cards)
                {
                    if (card == null) continue;
                    string kind = Normalize(card.Kind);
                    if (kind == null || !Renderable(card, kind)) continue;
                    queued.Add(card);
                }
            offered = queued.Count;
            if (offered == 0) return NoCards;
            Pull();
            StartAuto();
            return "Showing " + offered + (offered == 1 ? " explainer card." : " explainer cards.");
        }

        internal string Next()
        {
            // A plain set walks itself forward the same way a beat does, so "next" means the next card either way.
            if (queued.Count > 0)
            {
                Pull();
                if (queued.Count == 0) StopAuto();
                else StartAuto();
                return "Card " + (offered - queued.Count) + " of " + offered + ".";
            }
            if (beats.Length == 0)
            {
                StopAuto();
                CloseUnpinned();
                return "Closed the cards.";
            }
            beatIndex++;
            if (beatIndex >= beats.Length)
            {
                beatIndex = beats.Length;
                StopAuto();
                return LastBeat;
            }
            ExplainBeat beat = beats[beatIndex];
            int shown = 0;
            if (beat.Cards != null) foreach (ExplainCard card in beat.Cards) if (Add(card, beat.Say, true)) shown++;
            StartAuto();
            string say = beat.Say == null ? "" : beat.Say.Trim();
            if (shown == 0) return say.Length > 0 ? say : "Beat " + (beatIndex + 1) + " of " + beats.Length + ".";
            return "Beat " + (beatIndex + 1) + " of " + beats.Length + (say.Length > 0 ? ": " + say : ".");
        }

        // The next card off the queue, if there is one left on it.
        private bool Pull()
        {
            if (queued.Count == 0) return false;
            ExplainCard card = queued[0];
            queued.RemoveAt(0);
            return Add(card, null, false);
        }

        // Arms the clock that brings the next thing up on its own. Nothing left to bring up means no clock: a single
        // card, the last beat, or a set already walked to its end never starts one.
        private void StartAuto()
        {
            StopAuto();
            if (queued.Count == 0 && beatIndex + 1 >= beats.Length) return;
            auto = new Beat();
            auto.Interval = AutoMs < 1 ? 1 : AutoMs;
            auto.Tick += delegate
            {
                try { Step(); }
                catch (Exception) { StopAuto(); }
            };
            auto.Start();
        }

        private void StopAuto()
        {
            if (auto == null) return;
            Beat done = auto;
            auto = null;
            try { done.Stop(); done.Dispose(); }
            catch (Exception) { }
        }

        // One tick, one thing: the next card, or the next beat. Advancing this way restarts the clock from the new
        // card, so every one of them gets its own full interval whether it arrived on its own or was asked for.
        private void Step()
        {
            if (queued.Count > 0)
            {
                Pull();
                if (queued.Count == 0) StopAuto();
                return;
            }
            if (beatIndex + 1 < beats.Length) Next();
            else StopAuto();
        }

        internal string Clear()
        {
            StopAuto();
            StopExpiry();
            queued.Clear();
            offered = 0;
            foreach (ExplainCardWindow window in windows.ToArray()) window.Dispose();
            windows.Clear();
            beats = new ExplainBeat[0];
            beatIndex = -1;
            if (Idle != null) Idle();
            return Cleared;
        }

        internal void Close(ExplainCardWindow window)
        {
            if (window == null) return;
            if (windows.Remove(window)) window.Dispose();
            if (windows.Count == 0 && Idle != null) Idle();
        }

        internal void CardFinished()
        {
            if (!Finished || expiry != null) return;
            expiry = new Beat();
            expiry.Interval = 20000;
            expiry.Tick += delegate
            {
                StopExpiry();
                foreach (ExplainCardWindow window in windows.ToArray())
                    if (!window.Pinned && !window.IndividualExpiry) Close(window);
            };
            expiry.Start();
        }

        internal void PinChanged(ExplainCardWindow window)
        {
            if (!window.Pinned) window.StartExpiry();
        }

        private void StopExpiry()
        {
            if (expiry == null) return;
            Beat done = expiry;
            expiry = null;
            done.Stop();
            done.Dispose();
        }

        internal Point Place(int width, int height)
        {
            Rectangle area = Area();
            int margin = 48;
            int gap = 12;
            if (width > area.Width - margin * 2) width = area.Width - margin * 2;
            if (height > area.Height - margin * 2) height = area.Height - margin * 2;
            List<Rectangle> taken = new List<Rectangle>();
            foreach (ExplainCardWindow window in windows)
                if (window.Visible) taken.Add(Rectangle.Inflate(new Rectangle(window.Spot, new Size(window.CardWidth, window.CardHeight)), 6, 6));
            int x = area.Right - width - margin;
            int bottom = area.Bottom - height - margin;
            int top = area.Top + Headroom;
            if (top > bottom) top = area.Top + margin;
            for (int column = 0; column < 8 && x >= area.Left + margin; column++)
            {
                for (int y = top; y <= bottom; y += gap)
                {
                    Rectangle spot = new Rectangle(x, y, width, height);
                    bool free = true;
                    foreach (Rectangle other in taken) if (Rectangle.Intersect(spot, other).Width > 0 && Rectangle.Intersect(spot, other).Height > 0) { free = false; break; }
                    if (free) return new Point(x, y);
                }
                x -= width + 16;
            }
            int centreX = area.Left + Math.Max(margin, (area.Width - width) / 2);
            int centreY = area.Top + Math.Max(margin, (area.Height - height) / 2);
            return new Point(centreX, centreY);
        }

        private bool Add(ExplainCard card, string say, bool footer)
        {
            if (card == null) return false;
            string kind = Normalize(card.Kind);
            if (kind == null || !Renderable(card, kind)) return false;
            while (Unpinned() >= MaxCards) if (!CloseOldestUnpinned()) break;
            ExplainCardWindow window = new ExplainCardWindow(this, card, kind, say, footer);
            Size size = window.NaturalSize;
            window.SetSpot(Place(size.Width, size.Height));
            window.Open();
            windows.Add(window);
            return true;
        }

        private int Unpinned()
        {
            int count = 0;
            foreach (ExplainCardWindow window in windows) if (!window.Pinned) count++;
            return count;
        }

        private bool CloseOldestUnpinned()
        {
            foreach (ExplainCardWindow window in windows.ToArray())
            {
                if (window.Pinned) continue;
                windows.Remove(window);
                window.Dispose();
                return true;
            }
            return false;
        }

        private void CloseUnpinned()
        {
            foreach (ExplainCardWindow window in windows.ToArray())
            {
                if (window.Pinned) continue;
                windows.Remove(window);
                window.Dispose();
            }
        }


        internal static Rectangle Area()
        {
            try
            {
                Screen screen = Screen.FromPoint(Cursor.Position);
                if (screen != null) return screen.WorkingArea;
            }
            catch (Exception) { }
            return Screen.PrimaryScreen.WorkingArea;
        }

        internal static string Normalize(string kind)
        {
            string name = (kind ?? "").Trim().ToLowerInvariant();
            if (name.Length == 0) return "card";
            switch (name)
            {
                case "card": case "note": case "list": case "clip": case "sources":
                case "timeline": case "flow": case "table": case "bars": case "quiz": case "legend":
                case "graph": case "geometry": case "mindmap": case "map":
                    return name;
                // Marks that belong on the real screen aren't cards; a caller that sends one gets it ignored.
                case "point": case "target": case "hover": case "ring": case "frame": case "underline":
                case "strike": case "check": case "cross": case "connect": case "trace": case "num":
                case "label": case "write": case "scroll": case "spotlight": case "highlight": case "line":
                case "curve": case "arrow": case "circle": case "rect": case "emote": case "sfx":
                case "type": case "copy": case "open": case "handoff": case "button":
                    return null;
                default:
                    return "card";
            }
        }

        internal static bool Renderable(ExplainCard card, string kind)
        {
            if (card == null) return false;
            if (kind == "note") return !string.IsNullOrWhiteSpace(card.Text);
            if (kind == "list") return card.Items != null && card.Items.Length > 0;
            if (kind == "clip") return !string.IsNullOrWhiteSpace(card.Title) || !string.IsNullOrWhiteSpace(card.Text);
            if (kind == "sources") return card.Sources != null && card.Sources.Length > 0;
            if (kind == "timeline") return card.Events != null && card.Events.Length >= 2;
            if (kind == "graph") return GraphRenderable(card);
            if (kind == "geometry") return GeometryRenderable(card);
            if (kind == "mindmap") return card.Branches != null && card.Branches.Length >= 2 && card.Branches.Length <= 8 &&
                Array.TrueForAll(card.Branches, delegate(ExplainBranch branch) { return branch != null && !string.IsNullOrWhiteSpace(branch.Text) && (branch.Items == null || branch.Items.Length <= 6); });
            if (kind == "map") return MapRenderable(card);
            if (kind == "flow") return card.Nodes != null && card.Nodes.Length > 0;
            if (kind == "table") return card.Columns != null && card.Columns.Length >= 2 && card.Rows != null && card.Rows.Length > 0;
            if (kind == "bars") return card.Bars != null && card.Bars.Length >= 2;
            if (kind == "quiz")
            {
                if (card.Questions == null || card.Questions.Length == 0) return false;
                foreach (ExplainQuestion question in card.Questions)
                {
                    if (question == null || string.IsNullOrWhiteSpace(question.Text) || string.IsNullOrWhiteSpace(question.Answer) ||
                        question.Options == null || question.Options.Length < 2 || question.Options.Length > 4) return false;
                    foreach (string option in question.Options) if (string.IsNullOrWhiteSpace(option)) return false;
                    if (ExplainCardWindow.RightIndex(question) < 0) return false;
                }
                return true;
            }
            if (kind == "legend") return card.Keys != null && card.Keys.Length > 0;
            return !string.IsNullOrWhiteSpace(card.Heading) || !string.IsNullOrWhiteSpace(card.Text) || (card.Items != null && card.Items.Length > 0) || (card.Sources != null && card.Sources.Length > 0);
        }

        private static bool GraphRenderable(ExplainCard card)
        {
            if (card.Plots != null && card.Plots.Length > 4 || card.Dots != null && card.Dots.Length > 12) return false;
            bool data = false;
            if (card.Dots != null) foreach (ExplainPoint point in card.Dots)
            {
                if (point == null || double.IsNaN(point.X) || double.IsInfinity(point.X) || double.IsNaN(point.Y) || double.IsInfinity(point.Y)) return false;
                data = true;
            }
            if (card.Plots != null)
                foreach (ExplainPlot plot in card.Plots)
                {
                    if (plot == null || plot.Points == null || plot.Points.Length < 2 || plot.Points.Length > 200) continue;
                    bool valid = true;
                    foreach (double[] point in plot.Points)
                        if (point == null || point.Length < 2 || double.IsNaN(point[0]) || double.IsInfinity(point[0]) || double.IsNaN(point[1]) || double.IsInfinity(point[1])) valid = false;
                    if (valid) data = true;
                }
            return data && RangeValid(card.XRange) && RangeValid(card.YRange);
        }

        private static bool RangeValid(double[] range)
        {
            return range == null || (range.Length == 2 && !double.IsNaN(range[0]) && !double.IsInfinity(range[0]) &&
                !double.IsNaN(range[1]) && !double.IsInfinity(range[1]) && range[0] < range[1]);
        }

        private static bool GeometryRenderable(ExplainCard card)
        {
            if (card.Vertices == null || card.Vertices.Length < 2 || card.Vertices.Length > 16 ||
                card.FigureLines != null && card.FigureLines.Length > 24 || card.Angles != null && card.Angles.Length > 8 || card.Circles != null && card.Circles.Length > 4) return false;
            Dictionary<string, ExplainVertex> vertices = new Dictionary<string, ExplainVertex>();
            foreach (ExplainVertex vertex in card.Vertices)
            {
                if (vertex == null || string.IsNullOrWhiteSpace(vertex.Id) || double.IsNaN(vertex.X) || double.IsInfinity(vertex.X) || double.IsNaN(vertex.Y) || double.IsInfinity(vertex.Y) || vertices.ContainsKey(vertex.Id)) return false;
                vertices.Add(vertex.Id, vertex);
            }
            bool content = false;
            if (card.FigureLines != null) foreach (ExplainFigureLine line in card.FigureLines)
            {
                if (line == null || line.From == line.To || !vertices.ContainsKey(line.From ?? "") || !vertices.ContainsKey(line.To ?? "")) return false;
                content = true;
            }
            if (card.Circles != null) foreach (ExplainCircle circle in card.Circles)
            {
                if (circle == null || !vertices.ContainsKey(circle.At ?? "") || circle.Radius <= 0 || double.IsNaN(circle.Radius) || double.IsInfinity(circle.Radius)) return false;
                content = true;
            }
            if (card.Angles != null) foreach (ExplainAngle angle in card.Angles)
            {
                if (angle == null || !vertices.ContainsKey(angle.At ?? "") || !vertices.ContainsKey(angle.From ?? "") || !vertices.ContainsKey(angle.To ?? "") ||
                    angle.At == angle.From || angle.At == angle.To || angle.From == angle.To) return false;
                content = true;
            }
            foreach (ExplainVertex vertex in card.Vertices)
                if (vertex.X != card.Vertices[0].X || vertex.Y != card.Vertices[0].Y) return content;
            return false;
        }

        private static bool MapRenderable(ExplainCard card)
        {
            if (card.Shade != null && card.Shade.Length > 12 || card.Pins != null && card.Pins.Length > 12 || card.Routes != null && card.Routes.Length > 12) return false;
            if (string.IsNullOrWhiteSpace(card.Region) && (card.Shade == null || card.Shade.Length == 0) && (card.Pins == null || card.Pins.Length == 0)) return false;
            if (!string.IsNullOrWhiteSpace(card.Region))
            {
                string region = card.Region.Trim();
                bool valid = region.Equals("world", StringComparison.OrdinalIgnoreCase);
                foreach (ExplainMapCountry country in ExplainMapData.Countries)
                    if (country.Name.Equals(region, StringComparison.OrdinalIgnoreCase) || country.Continent.Equals(region, StringComparison.OrdinalIgnoreCase)) valid = true;
                if (!valid) return false;
            }
            if (card.Shade != null) foreach (ExplainMapShade shade in card.Shade)
            {
                if (shade == null || string.IsNullOrWhiteSpace(shade.Name)) return false;
                bool found = false;
                foreach (ExplainMapCountry country in ExplainMapData.Countries) if (country.Name.Equals(shade.Name, StringComparison.OrdinalIgnoreCase)) { found = true; break; }
                if (!found) return false;
            }
            HashSet<string> pins = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            if (card.Pins != null) foreach (ExplainMapPin pin in card.Pins)
                if (pin == null || string.IsNullOrWhiteSpace(pin.Name) || !pins.Add(pin.Name) || double.IsNaN(pin.Lat) || double.IsInfinity(pin.Lat) || pin.Lat < -90 || pin.Lat > 90 || double.IsNaN(pin.Lon) || double.IsInfinity(pin.Lon) || pin.Lon < -180 || pin.Lon > 180) return false;
            if (card.Routes != null) foreach (ExplainMapRoute route in card.Routes)
                if (route == null || string.IsNullOrWhiteSpace(route.From) || string.IsNullOrWhiteSpace(route.To) || route.From.Equals(route.To, StringComparison.OrdinalIgnoreCase) || !pins.Contains(route.From) || !pins.Contains(route.To)) return false;
            return true;
        }


        public void Dispose()
        {
            StopAuto();
            StopExpiry();
            queued.Clear();
            foreach (ExplainCardWindow window in windows.ToArray()) window.Dispose();
            windows.Clear();
        }
    }

    // One card on screen. It draws itself into a layered surface, and handles its own close, pin, drag, resize,
    // quiz picks and links, so a card feels like a small native panel rather than a click-through drawing.
    internal sealed class ExplainCardWindow : CardForm
    {
        private const int FooterHeight = 46;
        private const int BodyLine = 18;
        // How long the contents take to draw themselves once the box is open: one and four tenths of a
        // second, spread over the stages each kind draws in.
        private const double DrawSeconds = 1.4;
        private const int SmallLine = 13;
        private const int LabelLine = 13;
        private const int HeadLine = 25;
        private const int WhenLine = 18;

        private static readonly Font LabelFont = Look.Mono(10f, FontStyle.Regular, GraphicsUnit.Pixel);
        private static readonly Font SmallFont = Look.Mono(9.5f, FontStyle.Regular, GraphicsUnit.Pixel);
        private static readonly Font BodyFont = Neon.Type(14f, false, GraphicsUnit.Pixel);
        private static readonly Font BodySmall = Neon.Type(12f, false, GraphicsUnit.Pixel);
        private static readonly Font HeadFont = Neon.Display(21f, GraphicsUnit.Pixel);
        private static readonly Font HeadSmall = Neon.Display(16f, GraphicsUnit.Pixel);
        private static readonly Font WhenFont = Neon.Display(15f, GraphicsUnit.Pixel);

        private readonly Explainer owner;
        private readonly ExplainCard card;
        private readonly string kind;
        private readonly string say;
        private readonly bool hasFooter;
        private readonly Stopwatch clock = Stopwatch.StartNew();
        private CardSurface surface;
        private Beat anim;
        private Beat expire;
        private double reveal;
        private double typed;
        private double drawn;
        private Point spot;
        private int width, height;
        private bool pinned;
        private bool individualExpiry;
        private bool drawing;
        private Point focus;
        private int piece = -1;
        private string hover = "";
        private bool dragging, resizing;
        private Point dragCursor, dragSpot;
        private Point resizeCursor;
        private Size resizeSize;
        private int bodyTop, footerTop;
        private Rectangle closeRect, pinRect, beatNextRect, resizeRect, dragRect, quizNextRect;
        private List<string> headLines = new List<string>();
        private List<string> textLines = new List<string>();
        private List<string> footLines = new List<string>();
        private List<string> quizQuestionLines = new List<string>();
        private List<string> quizWhyLines = new List<string>();
        private List<List<string>> itemLines = new List<List<string>>();
        private List<List<string>> quizOptionLines = new List<List<string>>();
        private List<int> quizOptionTops = new List<int>();
        private List<Rectangle> optionRects = new List<Rectangle>();
        private List<Rectangle> linkRects = new List<Rectangle>();
        private List<string> linkUrls = new List<string>();
        private List<List<string>> tableHead = new List<List<string>>();
        private List<List<List<string>>> tableCells = new List<List<List<string>>>();
        private List<int> tableRowHeights = new List<int>();
        private List<int> tableRowTops = new List<int>();
        private List<int> itemTops = new List<int>();
        private List<int> barTops = new List<int>();
        private List<int> barHeights = new List<int>();
        private List<FlowBox> flowBoxes = new List<FlowBox>();
        private List<FlowLine> flowLines = new List<FlowLine>();
        private readonly Dictionary<string, PointF> geometryPoints = new Dictionary<string, PointF>();
        private Rectangle chartRect;
        private double graphXMin, graphXMax, graphYMin, graphYMax;
        private Rectangle mapRect;
        private double mapWest, mapEast, mapSouth, mapNorth;
        private float geometryScale;
        private Rectangle mindRoot;
        private List<MindBranchLayout> mindBranches = new List<MindBranchLayout>();
        private int tableHeadHeight, sourcesTop, quizWhyTop, quizIndex, quizScore;
        private int[] quizPicks;
        private bool quizAnswered, quizDone;

        private sealed class FlowBox
        {
            internal ExplainNode Node;
            internal Rectangle Rect;
            internal List<string> Lines;
        }

        private sealed class MindBranchLayout
        {
            internal ExplainBranch Branch;
            internal Rectangle Rect;
            internal List<string> Lines;
            internal List<List<string>> Items;
        }

        private sealed class FlowLine
        {
            internal Point[] Points;
            internal bool Back;
            internal bool Flow;
            internal string Label;
        }

        internal ExplainCardWindow(Explainer owner, ExplainCard card, string kind, string say, bool footer) : base("Capri explainer")
        {
            this.owner = owner;
            this.card = card;
            this.kind = kind;
            this.say = say == null ? "" : say;
            hasFooter = footer;
            ClickThrough = false;
            Above = true;
            int count = card.Questions == null ? 0 : card.Questions.Length;
            quizPicks = new int[count];
            for (int i = 0; i < count; i++) quizPicks[i] = -1;
            quizIndex = 0;
            Build();
        }

        internal int CardWidth { get { return width; } }
        internal int CardHeight { get { return height; } }
        internal Point Spot { get { return spot; } }
        internal bool Pinned { get { return pinned; } }
        internal bool Drawing { get { return drawing; } }
        internal Size NaturalSize { get { return new Size(width, height); } }

        internal void SetSpot(Point at) { spot = at; }

        internal void Open()
        {
            surface = new CardSurface(width, height);
            Bounds = new Rectangle(spot, new Size(width, height));
            reveal = 0;
            typed = 0;
            drawn = 0;
            focus = new Point(46, 26);
            piece = -1;
            drawing = true;
            Reflow();
            anim = new Beat();
            anim.Interval = 25;
            anim.Tick += delegate
            {
                try { Advance(); }
                catch (Exception) { reveal = 1; typed = 0.4; drawn = 1; drawing = false; try { Render(); } catch (Exception) { } anim.Stop(); }
            };
            anim.Start();
        }

        // Roamies' card spawn, kept whole: the hull eases open over four and a half tenths of a second, the
        // title types in over four tenths more, and behind them the contents draw themselves in stages — the
        // box first, then the things inside it, one piece at a time.
        private void Advance()
        {
            double at = clock.Elapsed.TotalSeconds;
            if (at < 0.45)
            {
                reveal = Neon.Ease(at / 0.45);
                Render();
                return;
            }
            bool opened = reveal >= 1;
            reveal = 1;
            typed = at - 0.45;
            drawn = (at - 0.45) / DrawSeconds;
            if (drawn > 1) drawn = 1;
            if (typed >= 0.4 && drawn >= 1)
            {
                Finish();
                if (HasFlow()) Render();
            }
            else if (opened) Render(); else Reflow();
        }

        private bool HasFlow()
        {
            if (kind != "flow") return false;
            foreach (FlowLine line in flowLines) if (line.Flow) return true;
            return false;
        }

        // Start the shared close timer only when the last card finishes drawing.
        private void Finish()
        {
            if (!drawing) return;
            drawing = false;
            if (!HasFlow() && anim != null) anim.Stop();
            if (owner.Done != null) owner.Done();
            owner.CardFinished();
        }

        internal bool IndividualExpiry { get { return individualExpiry; } }

        internal void StartExpiry()
        {
            if (pinned) return;
            StopExpiry();
            individualExpiry = true;
            expire = new Beat();
            expire.Interval = 20000;
            expire.Tick += delegate { StopExpiry(); owner.Close(this); };
            expire.Start();
        }

        private void StopExpiry()
        {
            if (expire == null) return;
            Beat old = expire;
            expire = null;
            individualExpiry = false;
            old.Stop();
            old.Dispose();
        }

        // Where the draw clock sits between two marks of the contents: nothing before the stage starts, and
        // all of it once the stage has finished drawing.
        private double Span(double from, double to)
        {
            if (drawn <= from) return 0;
            if (drawn >= to) return 1;
            return (drawn - from) / (to - from);
        }

        // One item of a stage: each takes its own slice of the clock and eases in, so rows, dots and labels
        // arrive one after another the way a pen works down a page.
        private double Pop(int index, int count, double from, double to)
        {
            if (count <= 0) return 1;
            double slot = (to - from) / count;
            if (slot <= 0) return 1;
            return Neon.Ease(Span(from + slot * index, from + slot * (index + 1)));
        }

        // A dot landing on the page: it springs a little past its size and settles back.
        private static double Spring(double u)
        {
            if (u <= 0) return 0;
            if (u >= 1) return 1;
            double k = u - 1;
            return 1 + 2.70158 * k * k * k + 1.70158 * k * k;
        }

        // A colour fading up into place as its piece arrives.
        private static Color Fade(Color ink, double p)
        {
            if (p >= 1) return ink;
            if (p <= 0) return Color.FromArgb(0, ink);
            if (p > 1) p = 1;
            return Color.FromArgb((int)Math.Round(ink.A * p), ink);
        }

        private void PointAt(Point at, int which)
        {
            if (which < piece) return;
            focus = at;
            piece = which;
        }

        private void Build()
        {
            Rectangle area = Explainer.Area();
            int baseWidth = BaseWidth(kind);
            int maxWidth = area.Width - 40;
            if (maxWidth < 260) maxWidth = 260;
            if (baseWidth > maxWidth) baseWidth = maxWidth;
            width = baseWidth;
            using (Bitmap scratch = new Bitmap(1, 1))
            using (Graphics graphics = Graphics.FromImage(scratch))
            {
                graphics.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;
                int content = kind == "quiz" ? MeasureQuiz(graphics) : Layout(graphics, 0);
                int full = ChromeHeight(kind) + content + (hasFooter ? FooterHeight : 0);
                int maxHeight = area.Height - 40;
                if (maxHeight < 160) maxHeight = 160;
                if (full > maxHeight) full = maxHeight;
                if (full < 90) full = 90;
                height = full;
                Layout(graphics, height);
            }
        }

        private void Reflow()
        {
            using (Bitmap scratch = new Bitmap(1, 1))
            using (Graphics graphics = Graphics.FromImage(scratch))
            {
                graphics.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;
                Layout(graphics, height);
            }
            Render();
        }

        private void MoveTo(Point at)
        {
            spot = at;
            if (IsHandleCreated) Bounds = new Rectangle(at, new Size(width, height));
        }

        private void ResizeTo(int nextWidth, int nextHeight)
        {
            Rectangle area = Explainer.Area();
            int minWidth = 260;
            int minHeight = 150;
            if (nextWidth < minWidth) nextWidth = minWidth;
            if (nextHeight < minHeight) nextHeight = minHeight;
            if (nextWidth > area.Width - 24) nextWidth = area.Width - 24;
            if (nextHeight > area.Height - 24) nextHeight = area.Height - 24;
            if (nextWidth == width && nextHeight == height) return;
            width = nextWidth;
            height = nextHeight;
            if (spot.X + width > area.Right) spot.X = area.Right - width;
            if (spot.Y + height > area.Bottom) spot.Y = area.Bottom - height;
            if (surface != null) { surface.Dispose(); surface = null; }
            surface = new CardSurface(width, height);
            Reflow();
        }

        protected override void WndProc(ref Message message)
        {
            if (message.Msg == 0x0021) { message.Result = new IntPtr(3); return; }
            base.WndProc(ref message);
        }

        protected override void OnMouseDown(MouseEventArgs e)
        {
            base.OnMouseDown(e);
            if (e.Button != MouseButtons.Left) return;
            Point at = e.Location;
            if (closeRect.Contains(at)) { owner.Close(this); return; }
            if (pinRect.Contains(at))
            {
                pinned = !pinned;
                if (pinned) StopExpiry();
                owner.PinChanged(this); Render(); return;
            }
            if (kind == "quiz" && quizNextRect.Contains(at)) { QuizNext(); return; }
            if (kind == "quiz" && !quizAnswered && !quizDone)
            {
                for (int i = 0; i < optionRects.Count; i++)
                    if (optionRects[i].Contains(at)) { QuizPick(i); return; }
            }
            for (int i = 0; i < linkRects.Count && i < linkUrls.Count; i++)
                if (linkRects[i].Contains(at)) { OpenUrl(linkUrls[i]); return; }
            if (hasFooter && beatNextRect.Contains(at)) { owner.Next(); return; }
            if (resizeRect.Contains(at))
            {
                resizing = true;
                resizeCursor = Cursor.Position;
                resizeSize = new Size(width, height);
                Capture = true;
                return;
            }
            if (dragRect.Contains(at))
            {
                dragging = true;
                dragCursor = Cursor.Position;
                dragSpot = spot;
                Capture = true;
            }
        }

        protected override void OnMouseMove(MouseEventArgs e)
        {
            base.OnMouseMove(e);
            if (dragging)
            {
                Rectangle area = Explainer.Area();
                Point now = Cursor.Position;
                int x = dragSpot.X + now.X - dragCursor.X;
                int y = dragSpot.Y + now.Y - dragCursor.Y;
                if (x < area.Left) x = area.Left;
                if (y < area.Top) y = area.Top;
                if (x + width > area.Right) x = area.Right - width;
                if (y + height > area.Bottom) y = area.Bottom - height;
                MoveTo(new Point(x, y));
                return;
            }
            if (resizing)
            {
                Point now = Cursor.Position;
                ResizeTo(resizeSize.Width + now.X - resizeCursor.X, resizeSize.Height + now.Y - resizeCursor.Y);
                return;
            }
            string found = Hit(e.Location);
            if (found != hover)
            {
                hover = found;
                Cursor = found == "drag" ? Cursors.SizeAll : found == "resize" ? Cursors.SizeNWSE : found.Length > 0 ? Cursors.Hand : Cursors.Default;
                Render();
            }
        }

        protected override void OnMouseUp(MouseEventArgs e)
        {
            base.OnMouseUp(e);
            if (dragging || resizing) { dragging = false; resizing = false; Capture = false; }
        }

        protected override void OnMouseLeave(EventArgs e)
        {
            base.OnMouseLeave(e);
            if (hover.Length > 0) { hover = ""; Cursor = Cursors.Default; Render(); }
        }

        private string Hit(Point at)
        {
            if (closeRect.Contains(at)) return "close";
            if (pinRect.Contains(at)) return "pin";
            if (kind == "quiz" && quizNextRect.Contains(at)) return "quiznext";
            if (kind == "quiz" && !quizAnswered && !quizDone)
                for (int i = 0; i < optionRects.Count; i++) if (optionRects[i].Contains(at)) return "option" + i;
            for (int i = 0; i < linkRects.Count; i++) if (linkRects[i].Contains(at)) return "link" + i;
            if (hasFooter && beatNextRect.Contains(at)) return "beatnext";
            if (resizeRect.Contains(at)) return "resize";
            if (dragRect.Contains(at)) return "drag";
            return "";
        }

        private void QuizPick(int pick)
        {
            if (quizDone || quizAnswered) return;
            quizPicks[quizIndex] = pick;
            quizAnswered = true;
            Reflow();
        }

        private void QuizNext()
        {
            ExplainQuestion[] questions = card.Questions;
            if (questions == null || questions.Length == 0) return;
            if (quizDone)
            {
                for (int i = 0; i < quizPicks.Length; i++) quizPicks[i] = -1;
                quizDone = false;
                quizAnswered = false;
                quizIndex = 0;
                Reflow();
                return;
            }
            if (!quizAnswered) return;
            if (quizIndex < questions.Length - 1)
            {
                quizIndex++;
                quizAnswered = false;
            }
            else
            {
                quizDone = true;
                quizScore = 0;
                for (int i = 0; i < questions.Length; i++) if (quizPicks[i] == RightIndex(questions[i])) quizScore++;
            }
            Reflow();
        }

        internal static int RightIndex(ExplainQuestion question)
        {
            if (question == null || question.Options == null || question.Answer == null) return -1;
            string answer = Same(question.Answer);
            for (int i = 0; i < question.Options.Length; i++) if (Same(question.Options[i]) == answer) return i;
            return -1;
        }

        private static string Same(string text)
        {
            return Regex.Replace((text ?? "").Trim().ToLowerInvariant(), @"\s+", " ");
        }

        private static int BaseWidth(string kind)
        {
            switch (kind)
            {
                case "note": return 300;
                case "list": return 340;
                case "clip": return 380;
                case "sources": return 360;
                case "timeline": return 400;
                case "graph": return 480;
                case "geometry": return 440;
                case "mindmap": return 480;
                case "flow": return 440;
                case "table": return 480;
                case "bars": return 400;
                case "quiz": return 400;
                case "legend": return 320;
                default: return 360;
            }
        }

        private static int ChromeHeight(string kind)
        {
            return kind == "note" || kind == "legend" ? 28 : 32;
        }

        private void SetRects()
        {
            bodyTop = ChromeHeight(kind);
            if (kind == "note" || kind == "legend")
            {
                closeRect = new Rectangle(width - 30, 3, 26, 24);
                pinRect = Rectangle.Empty;
                dragRect = new Rectangle(0, 0, width - 36, 26);
            }
            else
            {
                closeRect = new Rectangle(width - 30, 3, 26, 26);
                pinRect = new Rectangle(width - 58, 3, 26, 26);
                dragRect = new Rectangle(0, 0, width - 62, 32);
            }
            resizeRect = new Rectangle(width - 20, height - 20, 20, 20);
            if (hasFooter)
            {
                footerTop = height - FooterHeight;
                beatNextRect = new Rectangle(width - 108, footerTop + 9, 80, 26);
            }
            else
            {
                footerTop = height;
                beatNextRect = Rectangle.Empty;
            }
        }

        private int Layout(Graphics graphics, int cardHeight)
        {
            SetRects();
            headLines = new List<string>();
            textLines = new List<string>();
            itemLines = new List<List<string>>();
            itemTops = new List<int>();
            optionRects = new List<Rectangle>();
            linkRects = new List<Rectangle>();
            linkUrls = new List<string>();
            flowBoxes = new List<FlowBox>();
            flowLines = new List<FlowLine>();
            geometryPoints.Clear();
            chartRect = Rectangle.Empty;
            mapRect = Rectangle.Empty;
            tableHead = new List<List<string>>();
            tableCells = new List<List<List<string>>>();
            tableRowHeights = new List<int>();
            tableRowTops = new List<int>();
            barTops = new List<int>();
            barHeights = new List<int>();
            quizQuestionLines = new List<string>();
            quizOptionLines = new List<List<string>>();
            quizOptionTops = new List<int>();
            quizWhyLines = new List<string>();
            quizWhyTop = 0;
            sourcesTop = 0;
            footLines = new List<string>();
            if (hasFooter) footLines = Wrap(graphics, say, SmallFont, width - 130);
            switch (kind)
            {
                case "note": return LayoutNote(graphics);
                case "list": return LayoutList(graphics);
                case "clip": return LayoutClip(graphics);
                case "sources": return LayoutSources(graphics);
                case "timeline": return LayoutTimeline(graphics);
                case "graph": return LayoutGraph(graphics);
                case "geometry": return LayoutGeometry();
                case "mindmap": return LayoutMindmap(graphics);
                case "map": return LayoutMap();
                case "flow": return LayoutFlow(graphics);
                case "table": return LayoutTable(graphics);
                case "bars": return LayoutBars(graphics);
                case "quiz": return LayoutQuiz(graphics, cardHeight);
                case "legend": return LayoutLegend(graphics);
                default: return LayoutCard(graphics);
            }
        }

        private int LayoutCard(Graphics graphics)
        {
            int y = bodyTop + 10;
            int room = width - 36;
            if (!string.IsNullOrWhiteSpace(card.Heading)) headLines = Wrap(graphics, card.Heading, HeadFont, room);
            if (!string.IsNullOrWhiteSpace(card.Text)) textLines = Wrap(graphics, card.Text, BodyFont, room);
            if (card.Items != null) foreach (string item in card.Items) if (!string.IsNullOrWhiteSpace(item)) itemLines.Add(Wrap(graphics, item, BodyFont, room - 18));
            y += headLines.Count * HeadLine;
            if (headLines.Count > 0) y += 4;
            y += textLines.Count * BodyLine;
            if (textLines.Count > 0 && itemLines.Count > 0) y += 8;
            foreach (List<string> lines in itemLines) { itemTops.Add(y); y += lines.Count * BodyLine + 8; }
            if (card.Sources != null && card.Sources.Length > 0) { y += 8; sourcesTop = y; y += 22 + Math.Min(card.Sources.Length, 8) * 26; }
            return y - bodyTop + 10;
        }

        private int LayoutNote(Graphics graphics)
        {
            textLines = Wrap(graphics, card.Text, BodyFont, width - 34);
            return 16 + textLines.Count * BodyLine + 14;
        }

        private int LayoutList(Graphics graphics)
        {
            int y = bodyTop + 10;
            int room = width - 38;
            headLines = Wrap(graphics, string.IsNullOrWhiteSpace(card.Title) ? "list" : card.Title, HeadFont, room);
            y += headLines.Count * HeadLine + 8;
            if (card.Items != null) foreach (string item in card.Items)
                {
                    List<string> lines = Wrap(graphics, item, BodyFont, room - 22);
                    itemLines.Add(lines);
                    itemTops.Add(y);
                    y += lines.Count * BodyLine + 8;
                }
            return y - bodyTop + 10;
        }

        private int LayoutClip(Graphics graphics)
        {
            int y = bodyTop + 10;
            int room = width - 38;
            headLines = Wrap(graphics, string.IsNullOrWhiteSpace(card.Title) ? "clip" : card.Title, HeadSmall, room);
            textLines = Wrap(graphics, card.Text, BodySmall, room);
            y += headLines.Count * 21 + 8;
            y += textLines.Count * 17;
            return y - bodyTop + 12;
        }

        private int LayoutSources(Graphics graphics)
        {
            int y = bodyTop + 10;
            y += LabelLine + 8;
            if (card.Sources != null)
                for (int i = 0; i < card.Sources.Length && i < 8; i++)
                {
                    ExplainSource source = card.Sources[i];
                    if (source == null) continue;
                    linkRects.Add(new Rectangle(14, y, width - 28, 26));
                    linkUrls.Add(source.Url);
                    y += 28;
                }
            return y - bodyTop + 10;
        }

        private int LayoutTimeline(Graphics graphics)
        {
            ExplainEvent[] events = card.Events == null ? new ExplainEvent[0] : card.Events;
            int y = bodyTop + 16;
            foreach (ExplainEvent item in events)
            {
                if (item == null) continue;
                List<string> lines = Wrap(graphics, item.Text, SmallFont, width - 74);
                textLines.AddRange(lines);
                y += 46;
            }
            return 16 + Math.Max(1, events.Length) * 46;
        }

        private int LayoutLegend(Graphics graphics)
        {
            ExplainKey[] keys = card.Keys == null ? new ExplainKey[0] : card.Keys;
            int y = bodyTop + 8;
            foreach (ExplainKey key in keys) if (key != null) y += 22;
            return y - bodyTop + 10;
        }

        private int LayoutBars(Graphics graphics)
        {
            ExplainBar[] bars = card.Bars == null ? new ExplainBar[0] : card.Bars;
            int labelWidth = Math.Min(132, Math.Max(64, width / 3));
            int y = bodyTop + 10;
            foreach (ExplainBar bar in bars)
            {
                if (bar == null) continue;
                int lines = Wrap(graphics, bar.Label, BodySmall, labelWidth).Count;
                int row = Math.Max(28, lines * 15 + 10);
                barTops.Add(y);
                barHeights.Add(row);
                y += row;
            }
            return y - bodyTop + 10;
        }

        private int LayoutTable(Graphics graphics)
        {
            string[] columns = card.Columns == null ? new string[0] : card.Columns;
            int count = columns.Length;
            if (count == 0) return 40;
            int cellWidth = Math.Max(40, (width - 24) / count - 8);
            tableHeadHeight = 0;
            for (int i = 0; i < count; i++)
            {
                List<string> lines = Wrap(graphics, (columns[i] ?? "").ToUpperInvariant(), SmallFont, cellWidth);
                tableHead.Add(lines);
                if (lines.Count > tableHeadHeight) tableHeadHeight = lines.Count;
            }
            tableHeadHeight = tableHeadHeight * LabelLine + 12;
            int y = bodyTop + 10 + tableHeadHeight;
            if (card.Rows != null)
                foreach (string[] row in card.Rows)
                {
                    List<List<string>> cells = new List<List<string>>();
                    int lines = 1;
                    for (int i = 0; i < count; i++)
                    {
                        string value = row != null && i < row.Length ? row[i] : "";
                        List<string> cell = Wrap(graphics, value, BodySmall, cellWidth);
                        cells.Add(cell);
                        if (cell.Count > lines) lines = cell.Count;
                    }
                    tableCells.Add(cells);
                    int rowHeight = lines * 16 + 10;
                    tableRowHeights.Add(rowHeight);
                    tableRowTops.Add(y);
                    y += rowHeight;
                }
            return y - bodyTop + 10;
        }

        private int LayoutFlow(Graphics graphics)
        {
            ExplainNode[] nodes = card.Nodes == null ? new ExplainNode[0] : card.Nodes;
            ExplainLink[] links = card.Links == null ? new ExplainLink[0] : card.Links;
            Dictionary<string, int> rank = new Dictionary<string, int>();
            Dictionary<string, List<string>> next = new Dictionary<string, List<string>>();
            Dictionary<string, int> incoming = new Dictionary<string, int>();
            List<ExplainNode> uniqueNodes = new List<ExplainNode>();
            foreach (ExplainNode node in nodes)
            {
                if (node == null || string.IsNullOrWhiteSpace(node.Id)) continue;
                if (rank.ContainsKey(node.Id)) continue;
                rank[node.Id] = 0;
                next[node.Id] = new List<string>();
                incoming[node.Id] = 0;
                uniqueNodes.Add(node);
            }
            foreach (ExplainLink link in links)
            {
                if (link == null || link.From == null || link.To == null || link.From == link.To) continue;
                if (!rank.ContainsKey(link.From) || !rank.ContainsKey(link.To)) continue;
                next[link.From].Add(link.To);
                incoming[link.To]++;
            }
            Queue<string> ready = new Queue<string>();
            HashSet<string> placed = new HashSet<string>();
            foreach (ExplainNode node in uniqueNodes) if (incoming[node.Id] == 0) ready.Enqueue(node.Id);
            while (ready.Count > 0)
            {
                string id = ready.Dequeue();
                if (!placed.Add(id)) continue;
                foreach (string target in next[id])
                {
                    if (rank[target] < rank[id] + 1) rank[target] = rank[id] + 1;
                    incoming[target]--;
                    if (incoming[target] == 0) ready.Enqueue(target);
                }
            }
            // Lay out a cycle from one node and follow its remaining paths once; back edges cannot grow the graph.
            foreach (ExplainNode node in uniqueNodes)
            {
                if (placed.Contains(node.Id)) continue;
                rank[node.Id] = 0;
                ready.Enqueue(node.Id);
                while (ready.Count > 0)
                {
                    string id = ready.Dequeue();
                    if (!placed.Add(id)) continue;
                    foreach (string target in next[id])
                    {
                        if (placed.Contains(target)) continue;
                        rank[target] = rank[id] + 1;
                        ready.Enqueue(target);
                    }
                }
            }
            List<List<ExplainNode>> layers = new List<List<ExplainNode>>();
            int deepest = 0;
            foreach (ExplainNode node in uniqueNodes)
            {
                if (rank[node.Id] > deepest) deepest = rank[node.Id];
            }
            for (int i = 0; i <= deepest; i++) layers.Add(new List<ExplainNode>());
            foreach (ExplainNode node in uniqueNodes)
            {
                layers[rank[node.Id]].Add(node);
            }
            int y = bodyTop + 12;
            int room = width - 28;
            foreach (List<ExplainNode> layer in layers)
            {
                int count = layer.Count;
                if (count == 0) continue;
                int gap = 10;
                int nodeWidth = count == 1 ? Math.Min(room, 230) : (room - gap * (count - 1)) / count;
                if (nodeWidth < 64) nodeWidth = 64;
                int total = count * nodeWidth + (count - 1) * gap;
                int x = 14 + Math.Max(0, (room - total) / 2);
                int layerHeight = 30;
                foreach (ExplainNode node in layer)
                {
                    List<string> lines = Wrap(graphics, node.Text, SmallFont, nodeWidth - 14);
                    int nodeHeight = Math.Max(30, lines.Count * 13 + 14);
                    if (string.Equals(node.Shape, "diamond", StringComparison.OrdinalIgnoreCase)) nodeHeight += 8;
                    FlowBox box = new FlowBox();
                    box.Node = node;
                    box.Rect = new Rectangle(x, y, nodeWidth, nodeHeight);
                    box.Lines = lines;
                    flowBoxes.Add(box);
                    if (nodeHeight > layerHeight) layerHeight = nodeHeight;
                    x += nodeWidth + gap;
                }
                y += layerHeight + 30;
            }
            foreach (ExplainLink link in links)
            {
                if (link == null || link.From == null || link.To == null || link.From == link.To) continue;
                FlowBox from = null, to = null;
                foreach (FlowBox box in flowBoxes)
                {
                    if (box.Node.Id == link.From) from = box;
                    if (box.Node.Id == link.To) to = box;
                }
                if (from == null || to == null) continue;
                Point a = new Point(from.Rect.Left + from.Rect.Width / 2, from.Rect.Bottom);
                Point b = new Point(to.Rect.Left + to.Rect.Width / 2, to.Rect.Top);
                FlowLine line = new FlowLine();
                line.Back = b.Y <= a.Y;
                line.Flow = link.Flow == true;
                line.Label = link.Label;
                if (line.Back)
                {
                    int outX = from.Rect.Right + 8;
                    line.Points = new[] { new Point(from.Rect.Right, a.Y - 6), new Point(outX, a.Y - 6), new Point(outX, b.Y - 8), b };
                }
                else
                {
                    int mid = a.Y + Math.Max(8, (b.Y - a.Y) / 2);
                    line.Points = new[] { a, new Point(a.X, mid), new Point(b.X, mid), b };
                }
                flowLines.Add(line);
            }
            return y - bodyTop + 6;
        }

        private int LayoutGraph(Graphics graphics)
        {
            graphXMin = card.XRange == null ? double.PositiveInfinity : card.XRange[0];
            graphXMax = card.XRange == null ? double.NegativeInfinity : card.XRange[1];
            graphYMin = card.YRange == null ? double.PositiveInfinity : card.YRange[0];
            graphYMax = card.YRange == null ? double.NegativeInfinity : card.YRange[1];
            if (card.Plots != null) foreach (ExplainPlot plot in card.Plots) if (plot != null && plot.Points != null)
                foreach (double[] point in plot.Points) if (point != null && point.Length >= 2)
                {
                    if (!ValidGraphPoint(point)) continue;
                    if (card.XRange == null) { graphXMin = Math.Min(graphXMin, point[0]); graphXMax = Math.Max(graphXMax, point[0]); }
                    if (card.YRange == null) { graphYMin = Math.Min(graphYMin, point[1]); graphYMax = Math.Max(graphYMax, point[1]); }
                }
            if (card.Dots != null) foreach (ExplainPoint point in card.Dots) if (point != null)
            {
                if (card.XRange == null) { graphXMin = Math.Min(graphXMin, point.X); graphXMax = Math.Max(graphXMax, point.X); }
                if (card.YRange == null) { graphYMin = Math.Min(graphYMin, point.Y); graphYMax = Math.Max(graphYMax, point.Y); }
            }
            if (double.IsInfinity(graphXMin) || double.IsInfinity(graphXMax)) { graphXMin = 0; graphXMax = 1; }
            if (double.IsInfinity(graphYMin) || double.IsInfinity(graphYMax)) { graphYMin = 0; graphYMax = 1; }
            if (graphXMin == graphXMax) { graphXMin -= 1; graphXMax += 1; }
            if (graphYMin == graphYMax) { graphYMin -= 1; graphYMax += 1; }
            chartRect = new Rectangle(52, bodyTop + 16, width - 72, 150);
            return chartRect.Bottom - bodyTop + 38;
        }

        private int LayoutGeometry()
        {
            if (card.Vertices == null || card.Vertices.Length == 0) return 200;
            double xMin = double.PositiveInfinity, xMax = double.NegativeInfinity, yMin = double.PositiveInfinity, yMax = double.NegativeInfinity;
            foreach (ExplainVertex vertex in card.Vertices)
            {
                xMin = Math.Min(xMin, vertex.X); xMax = Math.Max(xMax, vertex.X);
                yMin = Math.Min(yMin, vertex.Y); yMax = Math.Max(yMax, vertex.Y);
            }
            if (xMin == xMax) { xMin -= 1; xMax += 1; }
            if (yMin == yMax) { yMin -= 1; yMax += 1; }
            Rectangle area = new Rectangle(40, bodyTop + 20, width - 80, 184);
            double scale = Math.Min(area.Width / (xMax - xMin), area.Height / (yMax - yMin));
            geometryScale = (float)scale;
            float usedW = (float)((xMax - xMin) * scale), usedH = (float)((yMax - yMin) * scale);
            float left = area.Left + (area.Width - usedW) / 2f, top = area.Top + (area.Height - usedH) / 2f;
            foreach (ExplainVertex vertex in card.Vertices)
                geometryPoints[vertex.Id] = new PointF(left + (float)((vertex.X - xMin) * scale), top + usedH - (float)((vertex.Y - yMin) * scale));
            return area.Bottom - bodyTop + 18;
        }

        private int LayoutMindmap(Graphics graphics)
        {
            mindBranches.Clear();
            int rootWidth = Math.Min(220, width - 48);
            string root = string.IsNullOrWhiteSpace(card.Heading) ? card.Title : card.Heading;
            List<string> rootLines = Wrap(graphics, string.IsNullOrWhiteSpace(root) ? "Ideas" : root, HeadSmall, rootWidth - 20);
            mindRoot = new Rectangle((width - rootWidth) / 2, bodyTop + 8, rootWidth, Math.Max(38, rootLines.Count * 16 + 14));
            int gap = 12, colWidth = (width - 24 - gap) / 2, y = mindRoot.Bottom + 26;
            ExplainBranch[] branches = card.Branches ?? new ExplainBranch[0];
            for (int row = 0; row < (branches.Length + 1) / 2; row++)
            {
                List<MindBranchLayout> pair = new List<MindBranchLayout>();
                int rowHeight = 0;
                for (int col = 0; col < 2; col++)
                {
                    int index = row * 2 + col;
                    if (index >= branches.Length) break;
                    ExplainBranch branch = branches[index];
                    MindBranchLayout layout = new MindBranchLayout();
                    layout.Branch = branch;
                    layout.Lines = Wrap(graphics, branch.Text, SmallFont, colWidth - 18);
                    layout.Items = new List<List<string>>();
                    if (branch.Items != null) foreach (string item in branch.Items) layout.Items.Add(Wrap(graphics, item, BodySmall, colWidth - 30));
                    int height = 30 + layout.Lines.Count * 14;
                    foreach (List<string> item in layout.Items) height += item.Count * 14 + 5;
                    layout.Rect = new Rectangle(12 + col * (colWidth + gap), y, colWidth, height + 8);
                    rowHeight = Math.Max(rowHeight, layout.Rect.Height);
                    mindBranches.Add(layout);
                    pair.Add(layout);
                }
                y += rowHeight + 12;
            }
            return y - bodyTop + 4;
        }

        private int LayoutMap()
        {
            mapWest = double.PositiveInfinity; mapEast = double.NegativeInfinity;
            mapSouth = double.PositiveInfinity; mapNorth = double.NegativeInfinity;
            bool world = string.Equals(card.Region, "world", StringComparison.OrdinalIgnoreCase);
            if (world) { mapWest = -180; mapEast = 180; mapSouth = -60; mapNorth = 85; }
            else if (!string.IsNullOrWhiteSpace(card.Region))
            {
                string region = card.Region.Trim().ToLowerInvariant();
                if (region == "europe") { mapWest = -25; mapEast = 45; mapSouth = 34; mapNorth = 72; }
                else if (region == "africa") { mapWest = -20; mapEast = 53; mapSouth = -36; mapNorth = 38; }
                else if (region == "asia") { mapWest = 25; mapEast = 180; mapSouth = -11; mapNorth = 78; }
                else if (region == "north america") { mapWest = -168; mapEast = -20; mapSouth = 7; mapNorth = 84; }
                else if (region == "south america") { mapWest = -82; mapEast = -34; mapSouth = -56; mapNorth = 13; }
                else if (region == "oceania") { mapWest = 110; mapEast = 180; mapSouth = -48; mapNorth = 0; }
                else if (region == "antarctica") { mapWest = -180; mapEast = 180; mapSouth = -90; mapNorth = -60; }
            }
            if (double.IsInfinity(mapWest)) foreach (ExplainMapCountry country in ExplainMapData.Countries)
            {
                bool include = string.IsNullOrWhiteSpace(card.Region) ? false : country.Name.Equals(card.Region.Trim(), StringComparison.OrdinalIgnoreCase) || country.Continent.Equals(card.Region.Trim(), StringComparison.OrdinalIgnoreCase);
                if (card.Shade != null) foreach (ExplainMapShade shade in card.Shade) if (country.Name.Equals(shade.Name, StringComparison.OrdinalIgnoreCase)) include = true;
                if (!include) continue;
                AddMapBounds(country);
            }
            if (card.Pins != null) foreach (ExplainMapPin pin in card.Pins) { mapWest = Math.Min(mapWest, pin.Lon); mapEast = Math.Max(mapEast, pin.Lon); mapSouth = Math.Min(mapSouth, pin.Lat); mapNorth = Math.Max(mapNorth, pin.Lat); }
            if (double.IsInfinity(mapWest)) { mapWest = -180; mapEast = 180; mapSouth = -60; mapNorth = 85; }
            double padX = Math.Max(2, (mapEast - mapWest) * 0.12), padY = Math.Max(2, (mapNorth - mapSouth) * 0.12);
            mapWest -= padX; mapEast += padX; mapSouth = Math.Max(-85, mapSouth - padY); mapNorth = Math.Min(85, mapNorth + padY);
            mapRect = new Rectangle(18, bodyTop + 14, width - 36, 218);
            double scale = Math.Min(mapRect.Width / (mapEast - mapWest), mapRect.Height / (mapNorth - mapSouth));
            int usedW = (int)Math.Round((mapEast - mapWest) * scale), usedH = (int)Math.Round((mapNorth - mapSouth) * scale);
            mapRect = new Rectangle(mapRect.Left + (mapRect.Width - usedW) / 2, mapRect.Top + (mapRect.Height - usedH) / 2, usedW, usedH);
            return mapRect.Bottom - bodyTop + 18;
        }

        private void AddMapBounds(ExplainMapCountry country)
        {
            foreach (PointF[] ring in country.Rings) foreach (PointF point in ring)
            { mapWest = Math.Min(mapWest, point.X); mapEast = Math.Max(mapEast, point.X); mapSouth = Math.Min(mapSouth, point.Y); mapNorth = Math.Max(mapNorth, point.Y); }
        }

        private Point MapPoint(double lon, double lat)
        {
            double x = (lon - mapWest) / Math.Max(0.001, mapEast - mapWest);
            double y = (lat - mapSouth) / Math.Max(0.001, mapNorth - mapSouth);
            return new Point(mapRect.Left + (int)Math.Round(x * mapRect.Width), mapRect.Bottom - (int)Math.Round(y * mapRect.Height));
        }

        private void PaintMap(Graphics graphics)
        {
            using (Brush sea = new SolidBrush(Color.FromArgb(28, 69, 91))) graphics.FillRectangle(sea, mapRect);
            using (Pen grid = new Pen(Color.FromArgb(38, Neon.Faint), 1f))
                for (int i = 1; i < 4; i++) graphics.DrawLine(grid, mapRect.Left, mapRect.Top + mapRect.Height * i / 4, mapRect.Right, mapRect.Top + mapRect.Height * i / 4);
            GraphicsState mapState = graphics.Save();
            graphics.SetClip(mapRect, CombineMode.Intersect);
            ExplainMapCountry[] countries = ExplainMapData.Countries.ToArray();
            int countryIndex = 0;
            foreach (ExplainMapCountry country in countries)
            {
                double p = Pop(countryIndex++, countries.Length, 0.12, 0.66);
                if (p <= 0) continue;
                ExplainMapShade shade = null;
                if (card.Shade != null) foreach (ExplainMapShade candidate in card.Shade) if (country.Name.Equals(candidate.Name, StringComparison.OrdinalIgnoreCase)) { shade = candidate; break; }
                Color edge = Color.FromArgb(120, 88, 137, 153);
                Color fill = shade == null ? Color.FromArgb(38, 84, 136, 151) : Color.FromArgb(150, Tone(shade.Tone));
                foreach (PointF[] ring in country.Rings)
                {
                    Point[] points = new Point[ring.Length];
                    for (int i = 0; i < ring.Length; i++) points[i] = MapPoint(ring[i].X, ring[i].Y);
                    if (points.Length < 3) continue;
                    using (Brush brush = new SolidBrush(Fade(fill, p))) graphics.FillPolygon(brush, points);
                    using (Pen pen = new Pen(Fade(edge, p), 1f)) graphics.DrawPolygon(pen, points);
                }
                if (shade != null && country.Rings.Count > 0 && country.Rings[0].Length > 0) PointAt(MapPoint(country.Rings[0][0].X, country.Rings[0][0].Y), 1);
            }
            Dictionary<string, ExplainMapPin> pins = new Dictionary<string, ExplainMapPin>(StringComparer.OrdinalIgnoreCase);
            if (card.Pins != null) foreach (ExplainMapPin pin in card.Pins) pins[pin.Name] = pin;
            if (card.Routes != null) foreach (ExplainMapRoute route in card.Routes)
            {
                ExplainMapPin from, to;
                if (!pins.TryGetValue(route.From, out from) || !pins.TryGetValue(route.To, out to)) continue;
                Point a = MapPoint(from.Lon, from.Lat), b = MapPoint(to.Lon, to.Lat);
                using (Pen pen = new Pen(Tone(route.Tone), 2f)) { pen.DashStyle = DashStyle.Dash; graphics.DrawLine(pen, a, b); }
                PointAt(new Point((a.X + b.X) / 2, (a.Y + b.Y) / 2), 40);
            }
            graphics.Restore(mapState);
            if (card.Pins != null) for (int i = 0; i < card.Pins.Length; i++)
            {
                ExplainMapPin pin = card.Pins[i]; Point point = MapPoint(pin.Lon, pin.Lat); double p = Pop(i, card.Pins.Length, 0.68, 1);
                using (Brush brush = new SolidBrush(Fade(Neon.Hot, p))) graphics.FillEllipse(brush, point.X - 4, point.Y - 4, 8, 8);
                DrawFit(graphics, pin.Name, point.X + 6, point.Y - 12, Math.Max(30, mapRect.Right - point.X - 8), SmallFont, Fade(Neon.White, p));
                PointAt(point, 50 + i);
            }
        }

        private void PaintMindmap(Graphics graphics)
        {
            double root = Pop(0, 1, 0, 0.25);
            if (root > 0)
            {
                using (GraphicsPath path = Neon.Stepped(new RectangleF(mindRoot.X, mindRoot.Y, mindRoot.Width, mindRoot.Height), 6, 0, 6, 0))
                using (Brush fill = new SolidBrush(Fade(Color.FromArgb(50, Neon.Glow), root)))
                using (Pen edge = new Pen(Fade(Color.FromArgb(210, Neon.Hot), root), 1.5f))
                {
                    graphics.FillPath(fill, path);
                    graphics.DrawPath(edge, path);
                }
                string rootText = string.IsNullOrWhiteSpace(card.Heading) ? card.Title : card.Heading;
                if (string.IsNullOrWhiteSpace(rootText)) rootText = "Ideas";
                DrawCenteredLines(graphics, Wrap(graphics, rootText, HeadSmall, mindRoot.Width - 20), mindRoot, mindRoot.Y + 8, HeadSmall, Fade(Neon.White, root));
                PointAt(new Point(mindRoot.X + mindRoot.Width / 2, mindRoot.Y + mindRoot.Height / 2), 1);
            }
            Point start = new Point(mindRoot.X + mindRoot.Width / 2, mindRoot.Bottom);
            for (int i = 0; i < mindBranches.Count; i++)
            {
                MindBranchLayout branch = mindBranches[i];
                Point end = new Point(branch.Rect.X + branch.Rect.Width / 2, branch.Rect.Y);
                double line = Pop(i, mindBranches.Count, 0.2, 0.5);
                if (line > 0)
                {
                    using (Pen pen = new Pen(Fade(Tone(branch.Branch.Tone), line), 1.5f))
                        graphics.DrawLine(pen, start, new Point(start.X + (int)((end.X - start.X) * line), start.Y + (int)((end.Y - start.Y) * line)));
                }
                double box = Pop(i, mindBranches.Count, 0.35, 0.72);
                if (box <= 0) continue;
                Color tone = Tone(branch.Branch.Tone);
                using (GraphicsPath path = Neon.Stepped(new RectangleF(branch.Rect.X, branch.Rect.Y, branch.Rect.Width, branch.Rect.Height), 5, 0, 5, 0))
                using (Brush fill = new SolidBrush(Fade(Color.FromArgb(34, tone), box)))
                using (Pen edge = new Pen(Fade(Color.FromArgb(190, tone), box), 1.2f))
                {
                    graphics.FillPath(fill, path);
                    graphics.DrawPath(edge, path);
                }
                DrawCenteredLines(graphics, branch.Lines, new Rectangle(branch.Rect.X + 6, branch.Rect.Y + 4, branch.Rect.Width - 12, 24), branch.Rect.Y + 8, SmallFont, Fade(Neon.White, box));
                int y = branch.Rect.Y + 30;
                for (int item = 0; item < branch.Items.Count; item++)
                {
                    double show = Pop(item + i * 6, Math.Max(branch.Items.Count, mindBranches.Count * 2), 0.58, 1);
                    if (show > 0)
                    {
                        using (Brush dot = new SolidBrush(Fade(tone, show))) graphics.FillEllipse(dot, branch.Rect.X + 10, y + 5, 3, 3);
                        DrawLines(graphics, branch.Items[item], branch.Rect.X + 19, y, 14, BodySmall, Fade(Neon.Tone(207, 216, 224), show));
                    }
                    y += branch.Items[item].Count * 14 + 5;
                }
                PointAt(end, 2 + i);
            }
        }

        private int MeasureQuiz(Graphics graphics)
        {
            ExplainQuestion[] questions = card.Questions == null ? new ExplainQuestion[0] : card.Questions;
            int max = 150;
            foreach (ExplainQuestion question in questions)
            {
                if (question == null) continue;
                int height = 12 + Wrap(graphics, question.Text, BodyFont, width - 36).Count * BodyLine + 10;
                if (question.Options != null)
                    foreach (string option in question.Options)
                        height += Wrap(graphics, option, BodySmall, width - 70).Count * 16 + 16 + 8;
                height += 20 + 18 + 44;
                if (height > max) max = height;
            }
            int score = 14 + 34 + 8 + questions.Length * 22 + 54;
            return max > score ? max : score;
        }

        private int LayoutQuiz(Graphics graphics, int cardHeight)
        {
            ExplainQuestion[] questions = card.Questions == null ? new ExplainQuestion[0] : card.Questions;
            if (quizDone || questions.Length == 0)
            {
                int bottom = cardHeight > 0 ? cardHeight - (hasFooter ? FooterHeight : 0) : bodyTop + 160;
                quizNextRect = new Rectangle(width - 108, bottom - 40, 88, 28);
                return 14 + 34 + 8 + questions.Length * 22 + 54;
            }
            if (quizIndex >= questions.Length) quizIndex = questions.Length - 1;
            ExplainQuestion question = questions[quizIndex];
            quizQuestionLines = Wrap(graphics, question == null ? "" : question.Text, BodyFont, width - 36);
            int y = bodyTop + 12;
            y += quizQuestionLines.Count * BodyLine + 8;
            if (question != null && question.Options != null)
                for (int i = 0; i < question.Options.Length && i < 4; i++)
                {
                    List<string> lines = Wrap(graphics, question.Options[i], BodySmall, width - 70);
                    int optionHeight = lines.Count * 16 + 16;
                    quizOptionLines.Add(lines);
                    quizOptionTops.Add(y);
                    optionRects.Add(new Rectangle(16, y, width - 32, optionHeight));
                    y += optionHeight + 8;
                }
            if (quizAnswered && question != null)
            {
                quizWhyTop = y + 4;
                quizWhyLines = Wrap(graphics, question.Explain, SmallFont, width - 36);
                y += 22 + quizWhyLines.Count * SmallLine;
            }
            int quizBottom = cardHeight > 0 ? cardHeight - (hasFooter ? FooterHeight : 0) : y + 44;
            quizNextRect = quizAnswered ? new Rectangle(width - 108, quizBottom - 40, 88, 28) : Rectangle.Empty;
            return y - bodyTop + 12;
        }

        private void Render()
        {
            if (surface == null) return;
            if (reveal < 1) PointAt(new Point(46, 26), 0);
            using (Graphics graphics = Graphics.FromImage(surface.Image))
            {
                graphics.Clear(Color.Transparent);
                graphics.SmoothingMode = SmoothingMode.AntiAlias;
                graphics.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;
                graphics.PixelOffsetMode = PixelOffsetMode.Half;
                float e = (float)reveal;
                if (e < 0.02f) e = 0.02f;
                RectangleF hull = new RectangleF(0, 0, width * e, height * e);
                Shape(hull, 12, 0, 12, 0);
                using (GraphicsPath clip = Neon.Stepped(hull, 12, 0, 12, 0))
                {
                    GraphicsState state = graphics.Save();
                    graphics.SetClip(clip);
                    PaintBack(graphics);
                    PaintBody(graphics);
                    PaintChrome(graphics);
                    PaintFooter(graphics);
                    PaintResize(graphics);
                    graphics.Restore(state);
                }
            }
            Present(surface.Image, spot);
            if (drawing && owner.Aim != null) owner.Aim(new Point(spot.X + focus.X, spot.Y + focus.Y));
        }

        private void PaintBack(Graphics graphics)
        {
            Color tone = Tone(card.Tone);
            RectangleF box = new RectangleF(0, 0, width, height);
            using (GraphicsPath path = Neon.Stepped(box, 12, 0, 12, 0))
            {
                using (LinearGradientBrush fill = new LinearGradientBrush(box, Color.FromArgb(248, Neon.Field), Color.FromArgb(250, Neon.Ground), 90f))
                    graphics.FillPath(fill, path);
                using (LinearGradientBrush wine = new LinearGradientBrush(new RectangleF(0, -1, 16, 90), Color.FromArgb(70, Neon.Glow), Color.FromArgb(0, Neon.Glow), LinearGradientMode.Vertical))
                    graphics.FillRectangle(wine, 1, 1, width - 2, 89);
                using (Pen edge = new Pen(Color.FromArgb(190, tone), 1f)) graphics.DrawPath(edge, path);
            }
            using (Pen hot = new Pen(Color.FromArgb(235, tone), 2f))
            {
                graphics.DrawLine(hot, 12, 1, Math.Min(width - 12, 62), 1);
                graphics.DrawLine(hot, width - 62, height - 1, width - 12, height - 1);
            }
            // Roamies' glint along the top: a thin white shine over the card's leading edge.
            using (Pen glint = new Pen(Color.FromArgb(110, Neon.White), 1f))
                graphics.DrawLine(glint, 18, 1, Math.Min(width - 16, 100), 1);
            // ...and while the title types itself in, a brighter shine sweeps the whole edge once.
            if (reveal >= 1 && typed > 0 && typed < 0.4)
            {
                float at = 18 + (width - 78) * (float)Neon.Ease(typed / 0.4);
                using (Pen sweep = new Pen(Color.FromArgb(180, Neon.White), 1f))
                    graphics.DrawLine(sweep, at, 1, Math.Min(width - 18, at + 60), 1);
            }
        }

        private void PaintChrome(Graphics graphics)
        {
            Color tone = Tone(card.Tone);
            if (kind == "note" || kind == "legend")
            {
                using (Pen line = new Pen(Color.FromArgb(190, tone), 2.5f)) graphics.DrawLine(line, 14, 9, Math.Max(20, width - 46), 9);
            }
            else
            {
                using (Brush band = new SolidBrush(Color.FromArgb(46, tone))) graphics.FillRectangle(band, 2, 2, width - 4, bodyTop - 3);
                using (Pen rule = new Pen(Color.FromArgb(110, Neon.Edge), 1f)) graphics.DrawLine(rule, 2, bodyTop, width - 2, bodyTop);
                using (Brush one = new SolidBrush(tone)) graphics.FillRectangle(one, 12, bodyTop / 2 - 2, 4, 4);
                using (Brush two = new SolidBrush(Color.FromArgb(160, Neon.Faint))) graphics.FillRectangle(two, 24, bodyTop / 2 - 2, 4, 4);
                string title = string.IsNullOrWhiteSpace(card.Title) ? kind : card.Title;
                // The title types itself in over Roamies' four tenths of a second, once the hull is open.
                string typedTitle = title.ToUpperInvariant();
                int cut = (int)(typedTitle.Length * Math.Min(1, typed / 0.4));
                if (cut > 0) DrawFit(graphics, typedTitle.Substring(0, cut), 38, bodyTop / 2 - 7, width - 150, LabelFont, Neon.Faint);
            }
            if (pinRect.Width > 0) PaintPin(graphics);
            PaintClose(graphics);
        }

        private void PaintPin(Graphics graphics)
        {
            Color tone = Tone(card.Tone);
            bool hot = hover == "pin";
            if (pinned)
            {
                using (GraphicsPath tile = Neon.Stepped(new RectangleF(pinRect.X + 2, pinRect.Y + 3, 22, 20), 0, 0, 4, 0))
                using (Brush fill = new SolidBrush(hot ? Color.FromArgb(230, Neon.Hot) : Color.FromArgb(210, tone))) graphics.FillPath(fill, tile);
            }
            Color ink = pinned ? Neon.Ground : hot ? Neon.Hot : Neon.Faint;
            using (Brush brush = new SolidBrush(ink))
            {
                graphics.FillRectangle(brush, pinRect.X + 8, pinRect.Y + 7, 10, 2);
                graphics.FillRectangle(brush, pinRect.X + 10, pinRect.Y + 9, 6, 4);
                graphics.FillRectangle(brush, pinRect.X + 7, pinRect.Y + 13, 12, 2);
                graphics.FillRectangle(brush, pinRect.X + 12, pinRect.Y + 15, 2, 5);
            }
        }

        private void PaintClose(Graphics graphics)
        {
            bool hot = hover == "close";
            using (Pen pen = new Pen(hot ? Neon.Hot : Neon.Faint, 1.7f))
            {
                int x = closeRect.X + closeRect.Width / 2;
                int y = closeRect.Y + closeRect.Height / 2;
                graphics.DrawLine(pen, x - 5, y - 5, x + 5, y + 5);
                graphics.DrawLine(pen, x - 5, y + 5, x + 5, y - 5);
            }
        }

        private void PaintFooter(Graphics graphics)
        {
            if (!hasFooter) return;
            using (Pen rule = new Pen(Color.FromArgb(110, Neon.Edge), 1f)) graphics.DrawLine(rule, 2, footerTop, width - 2, footerTop);
            int lines = Math.Min(2, footLines.Count);
            for (int i = 0; i < lines; i++)
                DrawLine(graphics, footLines[i], 14, footerTop + 7 + i * SmallLine, SmallFont, Neon.White);
            DrawChip(graphics, beatNextRect, "NEXT BEAT", Tone(card.Tone), hover == "beatnext");
        }

        private void PaintResize(Graphics graphics)
        {
            Color ink = hover == "resize" ? Neon.Hot : Color.FromArgb(110, Tone(card.Tone));
            using (Brush brush = new SolidBrush(ink))
                for (int k = 0; k < 3; k++)
                    for (int j = 0; j <= k; j++)
                        graphics.FillRectangle(brush, width - 7 - j * 4, height - 14 + k * 4, 2, 2);
        }

        private void PaintBody(Graphics graphics)
        {
            // Roamies holds the card's contents back until the hull has finished opening.
            if (reveal < 1) return;
            int bottom = hasFooter ? footerTop : height;
            Rectangle body = new Rectangle(2, bodyTop, width - 4, Math.Max(0, bottom - bodyTop - 2));
            GraphicsState state = graphics.Save();
            graphics.SetClip(body, CombineMode.Intersect);
            switch (kind)
            {
                case "note": PaintNote(graphics); break;
                case "list": PaintList(graphics); break;
                case "clip": PaintClip(graphics); break;
                case "sources": PaintSources(graphics); break;
                case "timeline": PaintTimeline(graphics); break;
                case "graph": PaintGraph(graphics); break;
                case "geometry": PaintGeometry(graphics); break;
                case "mindmap": PaintMindmap(graphics); break;
                case "map": PaintMap(graphics); break;
                case "flow": PaintFlow(graphics); break;
                case "table": PaintTable(graphics); break;
                case "bars": PaintBars(graphics); break;
                case "quiz": PaintQuiz(graphics); break;
                case "legend": PaintLegend(graphics); break;
                default: PaintCard(graphics); break;
            }
            graphics.Restore(state);
        }

        private void PaintCard(Graphics graphics)
        {
            Color tone = Tone(card.Tone);
            int y = bodyTop + 10;
            // Stage one: the heading lands...
            double head = Span(0, 0.2);
            if (head > 0)
            {
                DrawLines(graphics, headLines, 18, y, HeadLine, HeadFont, Fade(Neon.White, head));
                PointAt(new Point(18, y), 1);
            }
            y += headLines.Count * HeadLine;
            if (headLines.Count > 0) y += 4;
            // ...then the passage under it...
            double body = Span(0.2, 0.5);
            if (body > 0)
            {
                DrawLines(graphics, textLines, 18, y, BodyLine, BodyFont, Fade(Neon.Tone(222, 230, 235), body));
                PointAt(new Point(18, y), 2);
            }
            y += textLines.Count * BodyLine;
            if (textLines.Count > 0 && itemLines.Count > 0) y += 8;
            // ...then each point, ring first, one after another...
            for (int i = 0; i < itemLines.Count; i++)
            {
                double p = Pop(i, itemLines.Count, 0.5, 0.9);
                if (p > 0)
                {
                    DrawRing(graphics, 22, y + 7, Fade(tone, p));
                    DrawLines(graphics, itemLines[i], 38, y, BodyLine, BodyFont, Fade(Neon.White, p));
                    PointAt(new Point(30, y + 7), 3 + i);
                }
                y += itemLines[i].Count * BodyLine + 8;
            }
            // ...and last, the sources, link by link.
            double links = Span(0.9, 1);
            if (links > 0 && card.Sources != null && card.Sources.Length > 0)
                PaintSourcesAt(graphics, sourcesTop, card.Sources, 0.9, 1, 3 + itemLines.Count);
        }

        private void PaintNote(Graphics graphics)
        {
            // The note writes itself: each line fades up before the pen moves to the next.
            for (int i = 0; i < textLines.Count; i++)
            {
                double p = Pop(i, textLines.Count, 0, 0.6);
                if (p <= 0) continue;
                DrawLine(graphics, textLines[i], 17, bodyTop + 4 + i * BodyLine, BodyFont, Fade(Neon.White, p));
                PointAt(new Point(17, bodyTop + 4 + i * BodyLine), 1 + i);
            }
        }

        private void PaintList(Graphics graphics)
        {
            Color tone = Tone(card.Tone);
            int y = bodyTop + 10;
            // The title first, then each point in turn.
            double head = Span(0, 0.25);
            if (head > 0)
            {
                DrawLines(graphics, headLines, 18, y, HeadLine, HeadFont, Fade(Neon.White, head));
                PointAt(new Point(18, y), 1);
            }
            y += headLines.Count * HeadLine + 8;
            for (int i = 0; i < itemLines.Count; i++)
            {
                double p = Pop(i, itemLines.Count, 0.25, 1);
                if (p > 0)
                {
                    DrawRing(graphics, 22, y + 7, Fade(tone, p));
                    DrawLines(graphics, itemLines[i], 40, y, BodyLine, BodyFont, Fade(Neon.White, p));
                    PointAt(new Point(30, y + 7), 2 + i);
                }
                y += itemLines[i].Count * BodyLine + 8;
            }
        }

        private void PaintClip(Graphics graphics)
        {
            Color tone = Tone(card.Tone);
            int y = bodyTop + 10;
            int total = Math.Max(24, headLines.Count * 21 + 8 + textLines.Count * 17);
            // The rule beside the passage draws down first, then the label, then the words.
            double bar = Span(0, 0.3);
            if (bar > 0)
            {
                using (Brush fill = new SolidBrush(Fade(Color.FromArgb(190, tone), bar)))
                    graphics.FillRectangle(fill, 16, y + 2, 3, Math.Max(2, (int)(total * bar)));
                PointAt(new Point(16, y), 1);
            }
            double head = Span(0.3, 0.55);
            if (head > 0)
            {
                DrawLines(graphics, headLines, 28, y, 21, HeadSmall, Fade(Neon.White, head));
                PointAt(new Point(28, y), 2);
            }
            y += headLines.Count * 21 + 8;
            double body = Span(0.55, 1);
            if (body > 0)
            {
                DrawLines(graphics, textLines, 28, y, 17, BodySmall, Fade(Neon.Tone(196, 208, 216), body));
                PointAt(new Point(28, y), 3);
            }
        }

        private void PaintSources(Graphics graphics)
        {
            PaintSourcesAt(graphics, bodyTop + 10, card.Sources, 0, 1, 1);
        }

        // The sources list as its own stage: the label first, then each link in turn.
        private void PaintSourcesAt(Graphics graphics, int y, ExplainSource[] sources, double from, double to, int pieceBase)
        {
            Color tone = Tone(card.Tone);
            double slice = (to - from) / 4;
            double label = Span(from, from + slice);
            if (label > 0)
            {
                DrawLine(graphics, "SOURCES", 16, y, LabelFont, Fade(Neon.Faint, label));
                PointAt(new Point(16, y), pieceBase);
            }
            y += LabelLine + 8;
            int index = 0;
            if (sources == null) return;
            int count = linkRects.Count;
            foreach (ExplainSource source in sources)
            {
                if (source == null) continue;
                if (index >= count) break;
                double p = Pop(index, count, from + slice, to);
                if (p > 0)
                {
                    bool hot = hover == "link" + index;
                    using (Brush dot = new SolidBrush(hot ? Neon.Hot : Fade(tone, p))) graphics.FillRectangle(dot, 18, y + 4, 6, 6);
                    DrawFit(graphics, source.Name == null ? Host(source.Url) : source.Name, 32, y - 1, width - 58, BodySmall, Fade(hot ? Neon.Hot : Neon.White, p));
                    DrawFit(graphics, Host(source.Url), 32, y + 13, width - 58, SmallFont, Fade(Neon.Faint, p));
                    PointAt(new Point(32, y + 4), pieceBase + 1 + index);
                }
                index++;
                y += 28;
            }
        }

        private void PaintGraph(Graphics graphics)
        {
            double axes = Span(0, 0.2);
            if (axes <= 0) return;
            using (Pen grid = new Pen(Fade(Color.FromArgb(42, Neon.Faint), axes), 1f))
            using (Pen axis = new Pen(Fade(Color.FromArgb(150, Neon.Faint), axes), 1.2f))
            {
                for (int i = 0; i <= 4; i++)
                {
                    int x = chartRect.Left + chartRect.Width * i / 4, y = chartRect.Top + chartRect.Height * i / 4;
                    graphics.DrawLine(grid, x, chartRect.Top, x, chartRect.Bottom);
                    graphics.DrawLine(grid, chartRect.Left, y, chartRect.Right, y);
                    DrawFit(graphics, FormatGraph(graphXMin + (graphXMax - graphXMin) * i / 4), x - 26, chartRect.Bottom + 5, 52, SmallFont, Fade(Neon.Faint, axes));
                    DrawFit(graphics, FormatGraph(graphYMax - (graphYMax - graphYMin) * i / 4), 3, y - 7, 44, SmallFont, Fade(Neon.Faint, axes));
                }
                graphics.DrawLine(axis, chartRect.Left, chartRect.Top, chartRect.Left, chartRect.Bottom);
                graphics.DrawLine(axis, chartRect.Left, chartRect.Bottom, chartRect.Right, chartRect.Bottom);
            }
            ExplainPlot[] plots = card.Plots ?? new ExplainPlot[0];
            for (int i = 0; i < plots.Length; i++)
            {
                ExplainPlot plot = plots[i];
                if (plot == null || plot.Points == null || plot.Points.Length < 2 || plot.Points.Length > 200) continue;
                bool valid = true;
                foreach (double[] point in plot.Points) if (!ValidGraphPoint(point)) valid = false;
                if (!valid) continue;
                double p = Pop(i, plots.Length, 0.2, 0.82);
                if (p <= 0) continue;
                int shown = Math.Max(2, Math.Min(plot.Points.Length, (int)Math.Ceiling(1 + (plot.Points.Length - 1) * p)));
                Point[] points = new Point[shown];
                for (int j = 0; j < shown; j++) points[j] = GraphPoint(plot.Points[j][0], plot.Points[j][1]);
                Color tone = string.IsNullOrWhiteSpace(plot.Tone) ? Neon.Tone(97, 220, 190) : Tone(plot.Tone);
                using (Pen pen = new Pen(Fade(tone, p), 2f))
                {
                    pen.LineJoin = LineJoin.Round;
                    if (points.Length > 1) graphics.DrawLines(pen, points);
                }
                for (int j = 0; j < points.Length; j++)
                    using (Brush brush = new SolidBrush(Fade(tone, p))) graphics.FillEllipse(brush, points[j].X - 2, points[j].Y - 2, 4, 4);
                if (!string.IsNullOrWhiteSpace(plot.Label))
                    DrawFit(graphics, plot.Label, chartRect.Left + i * 110, chartRect.Bottom + 22, 104, SmallFont, Fade(tone, p));
                PointAt(points[points.Length - 1], 1 + i);
            }
            ExplainPoint[] dots = card.Dots ?? new ExplainPoint[0];
            for (int i = 0; i < dots.Length; i++)
            {
                ExplainPoint dot = dots[i];
                if (dot == null) continue;
                double p = Pop(i, dots.Length, 0.78, 1);
                if (p <= 0) continue;
                Point point = GraphPoint(dot.X, dot.Y);
                using (Brush brush = new SolidBrush(Fade(Neon.Hot, p))) graphics.FillEllipse(brush, point.X - 4, point.Y - 4, 8, 8);
                if (!string.IsNullOrWhiteSpace(dot.Label)) DrawFit(graphics, dot.Label, point.X + 6, point.Y - 12, chartRect.Right - point.X - 8, SmallFont, Fade(Neon.White, p));
                PointAt(point, 10 + i);
            }
        }

        private Point GraphPoint(double x, double y)
        {
            double across = Math.Max(0, Math.Min(1, (x - graphXMin) / (graphXMax - graphXMin)));
            double up = Math.Max(0, Math.Min(1, (y - graphYMin) / (graphYMax - graphYMin)));
            return new Point(chartRect.Left + (int)Math.Round(across * chartRect.Width), chartRect.Bottom - (int)Math.Round(up * chartRect.Height));
        }

        private static bool ValidGraphPoint(double[] point)
        {
            return point != null && point.Length >= 2 && !double.IsNaN(point[0]) && !double.IsInfinity(point[0]) && !double.IsNaN(point[1]) && !double.IsInfinity(point[1]);
        }

        private static string FormatGraph(double value)
        {
            return value.ToString("0.##", CultureInfo.InvariantCulture);
        }

        private void PaintGeometry(Graphics graphics)
        {
            ExplainFigureLine[] lines = card.FigureLines ?? new ExplainFigureLine[0];
            for (int i = 0; i < lines.Length; i++)
            {
                ExplainFigureLine line = lines[i];
                PointF a, b;
                if (!geometryPoints.TryGetValue(line.From, out a) || !geometryPoints.TryGetValue(line.To, out b)) continue;
                double p = Pop(i, lines.Length, 0, 0.55);
                if (p <= 0) continue;
                Color ink = string.IsNullOrWhiteSpace(line.Tone) ? Neon.Tone(97, 220, 190) : Tone(line.Tone);
                using (Pen pen = new Pen(Fade(ink, p), 2f))
                {
                    pen.DashStyle = line.Dash ? DashStyle.Dash : DashStyle.Solid;
                    graphics.DrawLine(pen, a, new PointF(a.X + (b.X - a.X) * (float)p, a.Y + (b.Y - a.Y) * (float)p));
                }
                if (p >= 1 && !string.IsNullOrWhiteSpace(line.Label))
                    DrawFit(graphics, line.Label, (int)((a.X + b.X) / 2) + 4, (int)((a.Y + b.Y) / 2) - 12, width / 3, SmallFont, Fade(Neon.Faint, p));
                PointAt(Point.Round(new PointF((a.X + b.X) / 2, (a.Y + b.Y) / 2)), 1 + i);
            }
            ExplainCircle[] circles = card.Circles ?? new ExplainCircle[0];
            for (int i = 0; i < circles.Length; i++)
            {
                ExplainCircle circle = circles[i];
                PointF center;
                if (!geometryPoints.TryGetValue(circle.At, out center)) continue;
                double p = Pop(i, circles.Length, 0.45, 0.75);
                float radius = Math.Max(2, (float)circle.Radius * geometryScale);
                Color ink = string.IsNullOrWhiteSpace(circle.Tone) ? Neon.Tone(97, 220, 190) : Tone(circle.Tone);
                using (Pen pen = new Pen(Fade(ink, p), 1.8f)) graphics.DrawArc(pen, center.X - radius, center.Y - radius, radius * 2, radius * 2, -90, (float)(360 * p));
                if (p >= 1 && !string.IsNullOrWhiteSpace(circle.Label)) DrawFit(graphics, circle.Label, (int)(center.X + radius + 3), (int)(center.Y - radius), 70, SmallFont, Fade(Neon.White, p));
            }
            ExplainAngle[] angles = card.Angles ?? new ExplainAngle[0];
            for (int i = 0; i < angles.Length; i++)
            {
                ExplainAngle angle = angles[i];
                PointF at, from, to;
                if (!geometryPoints.TryGetValue(angle.At, out at) || !geometryPoints.TryGetValue(angle.From, out from) || !geometryPoints.TryGetValue(angle.To, out to)) continue;
                double p = Pop(i, angles.Length, 0.5, 0.8);
                double start = Math.Atan2(from.Y - at.Y, from.X - at.X), finish = Math.Atan2(to.Y - at.Y, to.X - at.X);
                double sweep = ((finish - start + Math.PI * 3) % (Math.PI * 2)) - Math.PI;
                float radius = 16;
                using (Pen pen = new Pen(Fade(Neon.Tone(244, 190, 115), p), 1.6f)) graphics.DrawArc(pen, at.X - radius, at.Y - radius, radius * 2, radius * 2, (float)(start * 180 / Math.PI), (float)(sweep * p * 180 / Math.PI));
                if (p >= 1 && !string.IsNullOrWhiteSpace(angle.Label))
                {
                    double middle = start + sweep / 2;
                    DrawFit(graphics, angle.Label, (int)(at.X + Math.Cos(middle) * 25), (int)(at.Y + Math.Sin(middle) * 25), 48, SmallFont, Fade(Neon.White, p));
                }
            }
            int mark = 30;
            foreach (ExplainVertex vertex in card.Vertices)
            {
                PointF point;
                if (!geometryPoints.TryGetValue(vertex.Id, out point)) continue;
                using (Brush brush = new SolidBrush(Neon.Hot)) graphics.FillEllipse(brush, point.X - 3, point.Y - 3, 6, 6);
                DrawFit(graphics, vertex.Id, (int)point.X + 5, (int)point.Y - 15, 40, SmallFont, Neon.White);
                PointAt(Point.Round(point), mark++);
            }
        }

        private void PaintTimeline(Graphics graphics)
        {
            ExplainEvent[] events = card.Events == null ? new ExplainEvent[0] : card.Events;
            Color tone = Tone(card.Tone);
            int first = bodyTop + 24;
            int last = first + Math.Max(0, events.Length - 1) * 46;
            // Stage one: the spine draws itself down the card, from the first stop to the last...
            double spine = Span(0, 0.35);
            if (spine > 0)
            {
                int reach = first + (int)Math.Round((last - first) * spine);
                using (Pen line = new Pen(Color.FromArgb(120, Neon.Edge), 1.6f)) graphics.DrawLine(line, 26, first, 26, reach);
                PointAt(new Point(26, reach), 1);
            }
            int index = 0;
            foreach (ExplainEvent item in events)
            {
                if (item == null) continue;
                int y = bodyTop + 16 + index * 46;
                // ...then each stop's dot springs onto the line and settles...
                double dot = Spring(Pop(index, events.Length, 0.35, 0.7));
                if (dot > 0)
                {
                    int span = (int)Math.Round(12 * dot);
                    if (span < 1) span = 1;
                    using (Brush fill = new SolidBrush(tone)) graphics.FillEllipse(fill, 26 - span / 2, y + 8 - span / 2, span, span);
                    if (dot >= 1)
                        using (Brush core = new SolidBrush(Neon.Ground)) graphics.FillEllipse(core, 24, y + 6, 4, 4);
                    PointAt(new Point(26, y + 8), 2 + index);
                }
                // ...and last, the words arrive beside their stop.
                double words = Pop(index, events.Length, 0.7, 1);
                if (words > 0)
                {
                    Point tip = DrawTyping(graphics, new List<string> { item.When }, 44, y - 3, WhenLine, WhenFont, tone, Math.Min(1, words * 2));
                    int datePiece = 2 + events.Length + index * 2;
                    PointAt(tip, datePiece);
                    List<string> lines = Wrap(graphics, item.Text, SmallFont, width - 74);
                    double text = Math.Max(0, (words - 0.5) * 2);
                    if (text > 0)
                    {
                        tip = DrawTyping(graphics, lines, 44, y + 18, SmallLine, SmallFont, Neon.Tone(206, 216, 222), text);
                        PointAt(tip, datePiece + 1);
                    }
                }
                index++;
            }
        }

        private void PaintFlow(Graphics graphics)
        {
            Color mid = Color.FromArgb(180, Neon.Faint);
            // Stage one: the boxes land, one after another, each with its words...
            for (int b = 0; b < flowBoxes.Count; b++)
            {
                FlowBox box = flowBoxes[b];
                double p = Pop(b, flowBoxes.Count, 0, 0.6);
                if (p <= 0) continue;
                Color tone = Tone(box.Node.Tone);
                using (GraphicsPath path = Neon.Stepped(new RectangleF(box.Rect.X, box.Rect.Y, box.Rect.Width, box.Rect.Height), 6, 0, 6, 0))
                {
                    using (Brush fill = new SolidBrush(Fade(Color.FromArgb(40, tone), p))) graphics.FillPath(fill, path);
                    using (Pen pen = new Pen(Fade(Color.FromArgb(210, tone), p), 1.4f)) graphics.DrawPath(pen, path);
                }
                int textY = box.Rect.Y + Math.Max(6, (box.Rect.Height - box.Lines.Count * 13) / 2);
                DrawCenteredLines(graphics, box.Lines, box.Rect, textY, SmallFont, Fade(Neon.White, p));
                PointAt(new Point(box.Rect.X + box.Rect.Width / 2, box.Rect.Y + box.Rect.Height / 2), 1 + b);
            }
            // Stage two: the arrows draw between them, line first, head last.
            for (int l = 0; l < flowLines.Count; l++)
            {
                FlowLine line = flowLines[l];
                if (line.Points == null || line.Points.Length < 2) continue;
                double p = Pop(l, flowLines.Count, 0.6, 1);
                if (p <= 0) continue;
                Color ink = Fade(mid, p);
                using (Pen pen = new Pen(ink, 1.8f)) { pen.LineJoin = LineJoin.Round; graphics.DrawLines(pen, line.Points); }
                Point end = line.Points[line.Points.Length - 1];
                Point before = line.Points[line.Points.Length - 2];
                double angle = Math.Atan2(end.Y - before.Y, end.X - before.X);
                Point a = new Point(end.X - (int)(Math.Cos(angle - 0.45) * 8), end.Y - (int)(Math.Sin(angle - 0.45) * 8));
                Point b = new Point(end.X - (int)(Math.Cos(angle + 0.45) * 8), end.Y - (int)(Math.Sin(angle + 0.45) * 8));
                using (Brush head = new SolidBrush(ink)) graphics.FillPolygon(head, new[] { end, a, b });
                if (!string.IsNullOrWhiteSpace(line.Label))
                {
                    Point middle = line.Points[line.Points.Length / 2];
                    DrawFit(graphics, line.Label, middle.X + 5, middle.Y - 16, Math.Max(60, width - middle.X - 12), SmallFont, Fade(Neon.Faint, p));
                }
                if (line.Flow && p >= 1)
                {
                    double length = 0;
                    for (int i = 1; i < line.Points.Length; i++)
                    {
                        int dx = line.Points[i].X - line.Points[i - 1].X, dy = line.Points[i].Y - line.Points[i - 1].Y;
                        length += Math.Sqrt(dx * dx + dy * dy);
                    }
                    double gap = Math.Max(1, length / Math.Max(1, Math.Round(length / 46)));
                    double phase = (clock.Elapsed.TotalSeconds * 60) % gap;
                    using (Brush flow = new SolidBrush(Neon.Hot))
                    {
                        for (double distance = phase; distance < length; distance += gap)
                        {
                            double left = distance;
                            for (int i = 1; i < line.Points.Length; i++)
                            {
                                Point start = line.Points[i - 1], finish = line.Points[i];
                                double dx = finish.X - start.X, dy = finish.Y - start.Y, segment = Math.Sqrt(dx * dx + dy * dy);
                                if (left <= segment)
                                {
                                    int x = start.X + (segment == 0 ? 0 : (int)(dx * left / segment));
                                    int y = start.Y + (segment == 0 ? 0 : (int)(dy * left / segment));
                                    graphics.FillRectangle(flow, x - 2, y - 2, 4, 4);
                                    break;
                                }
                                left -= segment;
                            }
                        }
                    }
                }
                PointAt(end, 1 + flowBoxes.Count + l);
            }
        }

        private void PaintTable(Graphics graphics)
        {
            string[] columns = card.Columns == null ? new string[0] : card.Columns;
            int count = columns.Length;
            if (count == 0) return;
            int cellWidth = Math.Max(40, (width - 24) / count - 8);
            int x = 16;
            int headY = bodyTop + 12;
            // Stage one: the column headings and the rule under them...
            double head = Span(0, 0.25);
            if (head > 0)
            {
                for (int i = 0; i < count; i++)
                {
                    if (i < tableHead.Count) DrawLines(graphics, tableHead[i], x, headY, LabelLine, SmallFont, Fade(Neon.Faint, head));
                    x += cellWidth + 8;
                }
                using (Pen rule = new Pen(Fade(Color.FromArgb(130, Neon.Edge), head), 1f)) graphics.DrawLine(rule, 12, bodyTop + 10 + tableHeadHeight - 1, width - 12, bodyTop + 10 + tableHeadHeight - 1);
                PointAt(new Point(16, headY), 1);
            }
            // ...then each row in turn, band and all.
            for (int row = 0; row < tableCells.Count; row++)
            {
                double p = Pop(row, tableCells.Count, 0.25, 1);
                if (p <= 0) continue;
                int y = tableRowTops[row];
                if (row % 2 == 1)
                    using (Brush band = new SolidBrush(Fade(Color.FromArgb(18, Neon.Faint), p))) graphics.FillRectangle(band, 12, y, width - 24, tableRowHeights[row]);
                x = 16;
                for (int col = 0; col < tableCells[row].Count; col++)
                {
                    List<string> lines = tableCells[row][col];
                    DrawLines(graphics, lines, x, y + 5, 16, BodySmall, Fade(col == 0 ? Neon.White : Neon.Tone(208, 218, 224), p));
                    x += cellWidth + 8;
                }
                using (Pen rule = new Pen(Fade(Color.FromArgb(90, Neon.Edge), p), 1f)) graphics.DrawLine(rule, 12, y + tableRowHeights[row] - 1, width - 12, y + tableRowHeights[row] - 1);
                PointAt(new Point(16, y), 2 + row);
            }
        }

        private void PaintBars(Graphics graphics)
        {
            ExplainBar[] bars = card.Bars == null ? new ExplainBar[0] : card.Bars;
            int labelWidth = Math.Min(132, Math.Max(64, width / 3));
            int valueWidth = 58;
            int trackX = 16 + labelWidth + 10;
            int trackWidth = Math.Max(30, width - trackX - valueWidth - 16);
            double top = 1;
            foreach (ExplainBar bar in bars) if (bar != null && bar.Value > top) top = bar.Value;
            string unit = string.IsNullOrWhiteSpace(card.Unit) ? "" : " " + card.Unit.Trim();
            for (int i = 0; i < bars.Length; i++)
            {
                ExplainBar bar = bars[i];
                if (bar == null) continue;
                // Stage one: the label and its track appear...
                double show = Pop(i, bars.Length, 0, 0.4);
                if (show <= 0) continue;
                int y = barTops[i];
                int row = barHeights[i];
                List<string> names = Wrap(graphics, bar.Label, BodySmall, labelWidth);
                int nameY = y + (row - names.Count * 15) / 2;
                DrawRightLines(graphics, names, 16 + labelWidth, nameY, 15, BodySmall, Fade(Neon.White, show));
                int mid = y + row / 2;
                using (Brush track = new SolidBrush(Fade(Color.FromArgb(36, Neon.Faint), show))) graphics.FillRectangle(track, trackX, mid - 6, trackWidth, 12);
                // ...then the bar grows out to its value, carrying its number along.
                double share = top <= 0 ? 0 : Math.Max(0, bar.Value) / top;
                double grow = Pop(i, bars.Length, 0.3, 1);
                int filled = (int)Math.Round(trackWidth * share * grow);
                if (filled > 0)
                {
                    Color tone = Tone(bar.Tone);
                    using (Brush fill = new SolidBrush(Fade(tone, grow))) graphics.FillRectangle(fill, trackX, mid - 6, filled, 12);
                    using (Brush shine = new SolidBrush(Fade(Color.FromArgb(90, Neon.White), grow))) graphics.FillRectangle(shine, trackX, mid - 6, filled, 1);
                }
                DrawLine(graphics, FormatValue(bar.Value) + unit, trackX + filled + 8, mid - 6, BodySmall, Fade(Neon.White, grow));
                PointAt(new Point(trackX + filled, mid), 1 + i);
            }
        }

        private void PaintLegend(Graphics graphics)
        {
            ExplainKey[] keys = card.Keys == null ? new ExplainKey[0] : card.Keys;
            int y = bodyTop + 8;
            int index = 0;
            foreach (ExplainKey key in keys)
            {
                if (key == null) { index++; y += 22; continue; }
                // Each key pops in, dot first, its words a beat behind — but every row keeps its place.
                double p = Pop(index, keys.Length, 0, 0.8);
                Color tone = Tone(key.Tone);
                if (p > 0)
                {
                    using (Brush dot = new SolidBrush(Fade(tone, p))) graphics.FillEllipse(dot, 16, y + 5, 8, 8);
                    DrawFit(graphics, key.Text, 32, y, width - 50, BodySmall, Fade(Neon.Tone(214, 224, 230), p));
                    PointAt(new Point(24, y + 9), 1 + index);
                }
                index++;
                y += 22;
            }
        }

        private void PaintQuiz(Graphics graphics)
        {
            ExplainQuestion[] questions = card.Questions == null ? new ExplainQuestion[0] : card.Questions;
            Color tone = Tone(card.Tone);
            if (quizDone || questions.Length == 0)
            {
                int y = bodyTop + 12;
                DrawLine(graphics, quizScore + " of " + questions.Length, 18, y, HeadFont, Neon.White);
                DrawLine(graphics, "RIGHT", 18, y + 30, LabelFont, Neon.Faint);
                y += 48;
                for (int i = 0; i < questions.Length; i++)
                {
                    ExplainQuestion question = questions[i];
                    bool right = quizPicks[i] == RightIndex(question);
                    if (right) DrawTick(graphics, 18, y + 3, Tone("lime"));
                    else DrawCross(graphics, 18, y + 3, Tone("coral"));
                    List<string> lines = Wrap(graphics, question.Text, BodySmall, width - 54);
                    DrawLines(graphics, lines, 42, y, 16, BodySmall, Neon.White);
                    y += 22;
                }
                DrawChip(graphics, quizNextRect, "TRY AGAIN", tone, hover == "quiznext");
                return;
            }
            if (quizIndex >= questions.Length) quizIndex = questions.Length - 1;
            ExplainQuestion current = questions[quizIndex];
            int index = quizIndex;
            // Stage one: the counter and the question itself...
            double ask = Span(0, 0.3);
            if (ask > 0)
            {
                DrawRightFit(graphics, (index + 1) + " / " + questions.Length, width - 18, bodyTop + 6, width - 40, LabelFont, Fade(Neon.Faint, ask));
                DrawLines(graphics, quizQuestionLines, 18, bodyTop + 12, BodyLine, BodyFont, Fade(Neon.White, ask));
                PointAt(new Point(18, bodyTop + 12), 1);
            }
            int rightIndex = RightIndex(current);
            int picked = quizPicks[index];
            // ...then each answer choice, A to D, one after another.
            for (int i = 0; i < optionRects.Count; i++)
            {
                double p = Pop(i, optionRects.Count, 0.3, 0.9);
                if (p <= 0) continue;
                Rectangle rect = optionRects[i];
                bool right = i == rightIndex;
                bool mine = picked == i;
                bool answered = quizAnswered;
                bool hot = !answered && hover == "option" + i;
                Color border = answered ? (right ? Tone("lime") : mine ? Tone("coral") : Color.FromArgb(110, Neon.Edge)) : hot ? tone : Color.FromArgb(140, Neon.Edge);
                int alpha = answered && !right && !mine ? 70 : answered && (right || mine) ? 46 : hot ? 36 : 22;
                Color fillIn = answered && !right && !mine ? Neon.Faint : right ? Tone("lime") : mine ? Tone("coral") : tone;
                using (GraphicsPath path = Neon.Stepped(new RectangleF(rect.X, rect.Y, rect.Width, rect.Height), 4, 0, 4, 0))
                {
                    using (Brush fill = new SolidBrush(Fade(Color.FromArgb(alpha, fillIn), p))) graphics.FillPath(fill, path);
                    using (Pen pen = new Pen(Fade(border, p), answered && (right || mine) ? 2f : 1.2f)) graphics.DrawPath(pen, path);
                }
                if (!(answered && (right || mine)))
                    DrawCentered(graphics, "ABCD".Substring(i, 1), new Rectangle(rect.X + 4, rect.Y, 28, rect.Height), LabelFont, Fade(Neon.Faint, p));
                DrawLines(graphics, quizOptionLines[i], rect.X + 34, rect.Y + 8, 16, BodySmall, Fade(Neon.White, p));
                if (answered && (right || mine))
                {
                    int gx = rect.Right - 26;
                    int gy = rect.Y + rect.Height / 2 - 5;
                    if (right) DrawTick(graphics, gx, gy, Tone("lime")); else DrawCross(graphics, gx, gy, Tone("coral"));
                }
                PointAt(new Point(rect.X + 18, rect.Y + rect.Height / 2), 2 + i);
            }
            if (!quizAnswered || current == null) return;
            string verdict = picked == rightIndex ? "Right." : "Not quite: it's " + (rightIndex >= 0 && rightIndex < 4 ? "ABCD".Substring(rightIndex, 1) : "?") + ".";
            DrawLine(graphics, verdict, 18, quizWhyTop, BodySmall, Neon.White);
            DrawLines(graphics, quizWhyLines, 18, quizWhyTop + 18, SmallLine, SmallFont, Neon.Faint);
            string label = index < questions.Length - 1 ? "NEXT" : "SEE SCORE";
            DrawChip(graphics, quizNextRect, label, tone, hover == "quiznext");
        }

        private void DrawChip(Graphics graphics, Rectangle rect, string label, Color accent, bool hot)
        {
            if (rect.Width <= 0 || rect.Height <= 0) return;
            using (GraphicsPath path = Neon.Stepped(new RectangleF(rect.X, rect.Y, rect.Width, rect.Height), 0, 0, 5, 0))
            {
                using (Brush fill = new SolidBrush(Color.FromArgb(hot ? 70 : 26, accent))) graphics.FillPath(fill, path);
                using (Pen pen = new Pen(Color.FromArgb(hot ? 240 : 170, hot ? Neon.Hot : accent), 1f)) graphics.DrawPath(pen, path);
            }
            DrawCentered(graphics, label, rect, LabelFont, hot ? Neon.Hot : accent);
        }

        private static void DrawRing(Graphics graphics, int x, int y, Color tone)
        {
            using (Pen pen = new Pen(tone, 1.6f)) graphics.DrawEllipse(pen, x, y, 7, 7);
        }

        private static void DrawTick(Graphics graphics, int x, int y, Color color)
        {
            using (Pen pen = new Pen(color, 2.2f))
            {
                pen.StartCap = LineCap.Round;
                pen.EndCap = LineCap.Round;
                graphics.DrawLines(pen, new[] { new Point(x, y + 5), new Point(x + 4, y + 9), new Point(x + 11, y) });
            }
        }

        private static void DrawCross(Graphics graphics, int x, int y, Color color)
        {
            using (Pen pen = new Pen(color, 2.2f))
            {
                pen.StartCap = LineCap.Round;
                pen.EndCap = LineCap.Round;
                graphics.DrawLine(pen, x, y, x + 10, y + 10);
                graphics.DrawLine(pen, x, y + 10, x + 10, y);
            }
        }

        private static void DrawLine(Graphics graphics, string text, int x, int y, Font font, Color color)
        {
            if (string.IsNullOrEmpty(text)) return;
            using (Brush brush = new SolidBrush(color)) graphics.DrawString(text, font, brush, x, y, StringFormat.GenericTypographic);
        }

        private static void DrawFit(Graphics graphics, string text, int x, int y, int maxWidth, Font font, Color color)
        {
            if (string.IsNullOrEmpty(text)) return;
            DrawLine(graphics, Fit(graphics, text, font, maxWidth), x, y, font, color);
        }

        private static void DrawRightFit(Graphics graphics, string text, int right, int y, int maxWidth, Font font, Color color)
        {
            if (string.IsNullOrEmpty(text)) return;
            string fit = Fit(graphics, text, font, maxWidth);
            float width = Measure(graphics, fit, font);
            DrawLine(graphics, fit, (int)Math.Round(right - width), y, font, color);
        }

        private static void DrawLines(Graphics graphics, List<string> lines, int x, int y, int lineHeight, Font font, Color color)
        {
            if (lines == null) return;
            using (Brush brush = new SolidBrush(color))
                for (int i = 0; i < lines.Count; i++)
                    if (!string.IsNullOrEmpty(lines[i])) graphics.DrawString(lines[i], font, brush, x, y + i * lineHeight, StringFormat.GenericTypographic);
        }

        private Point DrawTyping(Graphics graphics, List<string> lines, int x, int y, int lineHeight, Font font, Color color, double progress)
        {
            int total = 0;
            if (lines != null) foreach (string line in lines) total += (line ?? "").Length;
            int visible = (int)Math.Ceiling(total * Math.Max(0, Math.Min(1, progress)));
            Point tip = new Point(x, y + lineHeight / 2);
            if (lines == null) return tip;
            for (int i = 0; i < lines.Count && visible > 0; i++)
            {
                string line = lines[i] ?? "";
                int count = Math.Min(visible, line.Length);
                if (count > 0)
                {
                    string shown = line.Substring(0, count);
                    DrawLine(graphics, shown, x, y + i * lineHeight, font, color);
                    tip = new Point(x + (int)Math.Round(Measure(graphics, shown, font)), y + i * lineHeight + lineHeight / 2);
                    visible -= count;
                }
            }
            return tip;
        }

        private static void DrawRightLines(Graphics graphics, List<string> lines, int right, int y, int lineHeight, Font font, Color color)
        {
            if (lines == null) return;
            using (Brush brush = new SolidBrush(color))
                for (int i = 0; i < lines.Count; i++)
                {
                    if (string.IsNullOrEmpty(lines[i])) continue;
                    float width = Measure(graphics, lines[i], font);
                    graphics.DrawString(lines[i], font, brush, right - width, y + i * lineHeight, StringFormat.GenericTypographic);
                }
        }

        private static void DrawCenteredLines(Graphics graphics, List<string> lines, Rectangle box, int top, Font font, Color color)
        {
            if (lines == null) return;
            using (Brush brush = new SolidBrush(color))
                for (int i = 0; i < lines.Count; i++)
                {
                    if (string.IsNullOrEmpty(lines[i])) continue;
                    float width = Measure(graphics, lines[i], font);
                    graphics.DrawString(lines[i], font, brush, box.Left + (box.Width - width) / 2, top + i * 13, StringFormat.GenericTypographic);
                }
        }

        private static void DrawCentered(Graphics graphics, string text, Rectangle box, Font font, Color color)
        {
            if (string.IsNullOrEmpty(text)) return;
            using (StringFormat format = new StringFormat())
            using (Brush brush = new SolidBrush(color))
            {
                format.Alignment = StringAlignment.Center;
                format.LineAlignment = StringAlignment.Center;
                graphics.DrawString(text, font, brush, box, format);
            }
        }

        // GDI+ measures a run of text up to about thirty-two thousand characters and refuses anything longer,
        // and no line of a card comes near that, so a longer run is measured from its first stretch instead.
        private const int MeasureLimit = 4000;

        // Wrapping stops well past the handful of screens a card can hold: past here the lines fall under the
        // card's own bottom edge and were never going to be read, so they are not worth the measuring.
        private const int LineLimit = 400;

        private static string Fit(Graphics graphics, string text, Font font, int maxWidth)
        {
            if (string.IsNullOrEmpty(text)) return "";
            if (maxWidth < 12) maxWidth = 12;
            if (text.Length <= MeasureLimit && Measure(graphics, text, font) <= maxWidth) return text;
            // Halving to the last stretch that still leaves room for the dots: counting down one character at a
            // time costs a measure per character, which a long title would feel on every paint.
            int low = 1;
            int high = Math.Min(text.Length, MeasureLimit);
            while (low < high)
            {
                int mid = (low + high + 1) / 2;
                if (Measure(graphics, text.Substring(0, mid) + "...", font) <= maxWidth) low = mid;
                else high = mid - 1;
            }
            return text.Substring(0, low).TrimEnd() + "...";
        }

        private static float Measure(Graphics graphics, string text, Font font)
        {
            if (string.IsNullOrEmpty(text)) return 0;
            if (text.Length > MeasureLimit) text = text.Substring(0, MeasureLimit);
            return graphics.MeasureString(text, font, 100000, StringFormat.GenericTypographic).Width;
        }

        // Whether a stretch of text belongs on one line. A run past the measure limit never does: it would be
        // cut off where it is measured, so it goes to the breaker and gets cut where it is drawn.
        private static bool Fits(Graphics graphics, string text, Font font, int maxWidth)
        {
            return text.Length <= MeasureLimit && Measure(graphics, text, font) <= maxWidth;
        }

        // The widest stretch of a run that still fits, found by halving rather than by stepping back one
        // character at a time: a long run would otherwise cost a measure per character before it reached
        // the screen, and the first of those measures would be one GDI+ refuses.
        private static int BreakAt(Graphics graphics, string word, Font font, int maxWidth)
        {
            int low = 1;
            int high = Math.Min(word.Length, MeasureLimit);
            while (low < high)
            {
                int mid = (low + high + 1) / 2;
                if (Measure(graphics, word.Substring(0, mid), font) <= maxWidth) low = mid;
                else high = mid - 1;
            }
            return low;
        }

        private static List<string> Wrap(Graphics graphics, string text, Font font, int maxWidth)
        {
            List<string> lines = new List<string>();
            if (string.IsNullOrEmpty(text)) return lines;
            if (maxWidth < 12) maxWidth = 12;
            string[] paragraphs = text.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n');
            foreach (string paragraph in paragraphs)
            {
                if (lines.Count >= LineLimit) break;
                if (paragraph.Length == 0) { lines.Add(""); continue; }
                string[] words = paragraph.Split(' ');
                string line = "";
                foreach (string word in words)
                {
                    if (lines.Count >= LineLimit) break;
                    if (word.Length == 0) continue;
                    string test = line.Length == 0 ? word : line + " " + word;
                    if (Fits(graphics, test, font, maxWidth)) { line = test; continue; }
                    if (line.Length > 0) { lines.Add(line); line = ""; }
                    if (Fits(graphics, word, font, maxWidth)) { line = word; continue; }
                    string rest = word;
                    while (rest.Length > 0 && lines.Count < LineLimit)
                    {
                        int take = BreakAt(graphics, rest, font, maxWidth);
                        lines.Add(rest.Substring(0, take));
                        rest = rest.Substring(take);
                    }
                }
                if (line.Length > 0) lines.Add(line);
            }
            return lines;
        }

        internal static Color Tone(string name)
        {
            switch ((name ?? "").Trim().ToLowerInvariant())
            {
                case "teal": return Neon.Cyan;
                case "amber": return Neon.Amber;
                case "coral": return Neon.Hot;
                case "lilac": return Neon.Violet;
                case "sky": return Neon.Blue;
                case "lime": return Neon.Mint;
                case "red": return Neon.Hot;
                case "white": return Neon.White;
                default: return Neon.Rose;
            }
        }

        private static string FormatValue(double value)
        {
            double size = Math.Abs(value);
            if (size >= 1000000000) return (value / 1000000000).ToString("0.##", CultureInfo.InvariantCulture) + "B";
            if (size >= 1000000) return (value / 1000000).ToString("0.##", CultureInfo.InvariantCulture) + "M";
            return value.ToString("0.##", CultureInfo.InvariantCulture);
        }

        private static string Host(string url)
        {
            Uri uri;
            if (!string.IsNullOrWhiteSpace(url) && Uri.TryCreate(url, UriKind.Absolute, out uri)) return uri.Host.Replace("www.", "");
            return url == null ? "" : url;
        }

        private static void OpenUrl(string url)
        {
            if (string.IsNullOrWhiteSpace(url)) return;
            Uri uri;
            if (!Uri.TryCreate(url, UriKind.Absolute, out uri)) return;
            if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps) return;
            try { Process.Start(new ProcessStartInfo(uri.AbsoluteUri) { UseShellExecute = true }); }
            catch (Exception) { }
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                drawing = false;
                StopExpiry();
                if (anim != null) { anim.Dispose(); anim = null; }
                if (surface != null) { surface.Dispose(); surface = null; }
            }
            base.Dispose(disposing);
        }
    }
}
