            foreach (object each in given) if (each != null) made.Add(each as string ?? each.ToString());
            return made.ToArray();
        }

        private static List<object> Array(Dictionary<string, object> one, string key)
        {
            object value;
            if (!one.TryGetValue(key, out value)) return null;
            return value as List<object>;
        }

        private static object Value(string text, ref int at, int depth)
        {
            // Anything can arrive from her brain, but a nest deep enough to fall over isn't an explanation.
            if (depth > 64) throw new FormatException("That explanation is nested too deep.");
            Skip(text, ref at);
            if (at >= text.Length) throw new FormatException("That explanation stopped early.");
            char first = text[at];
            if (first == '{') return Object(text, ref at, depth);
            if (first == '[') return List(text, ref at, depth);
            if (first == '"') return String(text, ref at);
            if (first == 't') { Word(text, ref at, "true"); return true; }
            if (first == 'f') { Word(text, ref at, "false"); return false; }
            if (first == 'n') { Word(text, ref at, "null"); return null; }
            return Number(text, ref at);
        }

        private static Dictionary<string, object> Object(string text, ref int at, int depth)
        {
            Dictionary<string, object> made = new Dictionary<string, object>();
            at++;
            Skip(text, ref at);
            if (Peek(text, at) == '}') { at++; return made; }
            while (true)
            {
                Skip(text, ref at);
                if (at >= text.Length || text[at] != '"') throw new FormatException("A card's fields need names in quotes.");
                string key = String(text, ref at);
                Skip(text, ref at);
                if (at >= text.Length || text[at] != ':') throw new FormatException("Expected a colon after " + key + ".");
                at++;
                made[key] = Value(text, ref at, depth + 1);
                Skip(text, ref at);
                char next = Peek(text, at);
                if (next == ',') { at++; continue; }
                if (next == '}') { at++; return made; }
                throw new FormatException("Expected a comma or a closing brace.");
            }
        }

        private static List<object> List(string text, ref int at, int depth)
        {
            List<object> made = new List<object>();
            at++;
            Skip(text, ref at);
            if (Peek(text, at) == ']') { at++; return made; }
            while (true)
            {
                made.Add(Value(text, ref at, depth + 1));
                Skip(text, ref at);
                char next = Peek(text, at);
                if (next == ',') { at++; continue; }
                if (next == ']') { at++; return made; }
                throw new FormatException("Expected a comma or a closing bracket.");
            }
        }

        private static string String(string text, ref int at)
        {
            StringBuilder made = new StringBuilder();
            at++;
            while (at < text.Length)
            {
                char c = text[at++];
                if (c == '"') return made.ToString();
                if (c != '\\') { made.Append(c); continue; }
                if (at >= text.Length) break;
                char escape = text[at++];
                switch (escape)
                {
                    case '"': made.Append('"'); break;
                    case '\\': made.Append('\\'); break;
                    case '/': made.Append('/'); break;
                    case 'b': made.Append('\b'); break;
                    case 'f': made.Append('\f'); break;
                    case 'n': made.Append('\n'); break;
                    case 'r': made.Append('\r'); break;
                    case 't': made.Append('\t'); break;
                    case 'u':
                        if (at + 4 > text.Length) throw new FormatException("A letter in the text wasn't written properly.");
                        made.Append((char)int.Parse(text.Substring(at, 4), NumberStyles.HexNumber, CultureInfo.InvariantCulture));
                        at += 4;
                        break;
                    default: throw new FormatException("That escape isn't one JSON uses.");
                }
            }
            throw new FormatException("A piece of text was left open.");
        }

        private static double Number(string text, ref int at)
        {
            int start = at;
            while (at < text.Length && "+-0123456789.eE".IndexOf(text[at]) >= 0) at++;
            double value;
            if (!double.TryParse(text.Substring(start, at - start), NumberStyles.Float, CultureInfo.InvariantCulture, out value))
                throw new FormatException("Expected a number.");
            return value;
        }

        private static void Word(string text, ref int at, string word)
        {
            if (at + word.Length > text.Length || text.Substring(at, word.Length) != word)
                throw new FormatException("Expected " + word + ".");
            at += word.Length;
        }

        private static char Peek(string text, int at) { return at < text.Length ? text[at] : '\0'; }

        private static void Skip(string text, ref int at)
        {
            while (at < text.Length && char.IsWhiteSpace(text[at])) at++;
        }
    }
